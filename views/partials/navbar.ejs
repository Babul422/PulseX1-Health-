<% 
    const activeUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null); 
%>

<!-- DYNAMIC REUSABLE PULSEX TOP NAVIGATION BAR -->
<div class="navbar-container">
    <nav class="navbar" aria-label="Main Navigation">

        <a href="/" class="logo" aria-label="PulseX Home">
            <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
            <span>PulseX</span>
        </a>

        <div class="nav-right">
            <% if (activeUser) { %>
                <!-- AUTHENTICATED USER NAVIGATION -->
                <ul class="nav-links" id="navLinks">
                    <li><a href="/" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'home') ? 'nav-link-active' : '' %>">Home</a></li>
                    <li><a href="/hospitals" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'hospitals') ? 'nav-link-active' : '' %>">Hospitals</a></li>
                    <li><a href="/doctors" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'doctors') ? 'nav-link-active' : '' %>">Doctors</a></li>
                    <li><a href="/#blood-bank">Blood Bank</a></li>
                    <li><a href="/emergency" class="nav-link-emergency <%= (typeof activeTab !== 'undefined' && activeTab === 'emergency') ? 'nav-link-active' : '' %>">Emergency</a></li>
                    <li><a href="/#ai-assistant">AI Triage</a></li>
                    <li><a href="/dashboard" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'nav-link-active' : '' %>" style="color:#38bdf8; font-weight:700;">Dashboard</a></li>
                    <li><a href="/notifications" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'notifications') ? 'nav-link-active' : '' %>">🔔</a></li>
                </ul>

                <!-- USER AVATAR & PROFILE DROPDOWN MENU -->
                <div class="nav-actions" style="position:relative;">
                    <div class="user-avatar-trigger" onclick="toggleProfileDropdown(event)" style="display:flex; align-items:center; gap:8px; cursor:pointer; background:rgba(14,165,233,0.12); padding:6px 14px; border-radius:30px; border:1px solid rgba(14,165,233,0.3); transition:background 0.2s ease;">
                        <img src="<%= activeUser.avatar_url || '/images/default-avatar.png' %>" alt="User Avatar" style="width:32px; height:32px; border-radius:50%; object-fit:cover; border:2px solid #0ea5e9;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(activeUser.full_name || 'User') %>&background=0ea5e9&color=fff&size=32'">
                        <span style="color:#fff; font-size:0.9rem; font-weight:600;"><%= activeUser.full_name ? activeUser.full_name.split(' ')[0] : 'Account' %></span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"></path></svg>
                    </div>

                    <!-- PROFILE DROPDOWN MENU -->
                    <div class="profile-dropdown-menu" id="profileDropdownMenu" style="display:none; position:absolute; top:48px; right:0; width:240px; background:#0f172a; border:1px solid rgba(255,255,255,0.12); border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,0.6); backdrop-filter:blur(20px); z-index:1000; padding:12px 0;">
                        <div style="padding:10px 16px; border-bottom:1px solid rgba(255,255,255,0.08);">
                            <div style="color:#fff; font-weight:700; font-size:0.95rem;"><%= activeUser.full_name || 'Alex Johnson' %></div>
                            <div style="color:#94a3b8; font-size:0.8rem; margin-top:2px;"><%= activeUser.email || 'patient@pulsex.health' %></div>
                            <span class="role-tag tag-doctor" style="background:rgba(14,165,233,0.15); color:#38bdf8; font-size:0.7rem; margin-top:6px; display:inline-block; padding:2px 8px; border-radius:10px;"><%= activeUser.role || 'PATIENT' %></span>
                        </div>
                        <div style="padding:6px 0;">
                            <a href="/dashboard" class="dropdown-item">📊 Dashboard</a>
                            <a href="/profile" class="dropdown-item">👤 Profile</a>
                            <a href="/profile" class="dropdown-item">⚙️ Settings</a>
                        </div>
                        <div style="border-top:1px solid rgba(255,255,255,0.08); padding-top:6px;">
                            <a href="/api/auth/logout" class="dropdown-item nav-link-logout" style="color:#f87171;">🚪 Logout</a>
                        </div>
                    </div>
                </div>

            <% } else { %>
                <!-- GUEST / VISITOR NAVIGATION -->
                <ul class="nav-links" id="navLinks">
                    <li><a href="/">Home</a></li>
                    <li><a href="/#hospitals">Hospitals</a></li>
                    <li><a href="/#doctors">Doctors</a></li>
                    <li><a href="/#blood-bank">Blood Bank</a></li>
                    <li><a href="/#emergency" class="nav-link-emergency">Emergency</a></li>
                    <li><a href="/#ai-assistant">AI Triage</a></li>
                    <li class="mobile-only-action"><a href="/login" class="nav-link-signin">Sign In</a></li>
                    <li class="mobile-only-action"><a href="/signup" class="btn-getstarted mobile-btn">Get Started</a></li>
                </ul>

                <div class="nav-actions">
                    <a href="/login" class="nav-link-signin">Sign In</a>
                    <a href="/signup" class="btn-getstarted">Get Started</a>
                </div>
            <% } %>

            <button class="menu-toggle" id="menuToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>

    </nav>
</div>

<style>
    .dropdown-item {
        display: block;
        padding: 8px 16px;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }
    .dropdown-item:hover {
        background: rgba(14, 165, 233, 0.15);
        color: #fff;
    }
    .nav-link-active {
        color: #38bdf8 !important;
        font-weight: 700 !important;
    }
</style>

<script>
    function toggleProfileDropdown(e) {
        if (e) e.stopPropagation();
        const menu = document.getElementById('profileDropdownMenu');
        if (menu) {
            menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
        }
    }
    document.addEventListener('click', function(e) {
        const menu = document.getElementById('profileDropdownMenu');
        if (menu && menu.style.display === 'block') {
            menu.style.display = 'none';
        }
    });
</script>
