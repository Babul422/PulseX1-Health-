<!-- REUSABLE AUTHENTICATED USER PROFILE SIDEBAR -->
<div class="auth-sidebar-card" style="position:relative; overflow:hidden;">
    
    <!-- Circular Avatar Wrapper -->
    <div class="avatar-wrapper" style="position:relative; width:96px; height:96px; margin:0 auto 16px;">
        <img id="avatarImage" src="<%= (user && user.avatar_url) ? user.avatar_url : '/images/default-avatar.png' %>" alt="Profile Picture" style="width:96px; height:96px; border-radius:50%; object-fit:cover; border:3px solid #38bdf8; box-shadow:0 0 20px rgba(56,189,248,0.3);" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent((user && user.full_name) ? user.full_name : 'User') %>&background=0ea5e9&color=fff&size=140'">
        <label for="avatarInput" class="avatar-upload-btn" title="Upload Profile Picture" style="position:absolute; bottom:2px; right:2px; background:#0ea5e9; color:#fff; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; border:2px solid #0b1329;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        </label>
        <input type="file" id="avatarInput" accept="image/*" style="display:none;" onchange="uploadAvatarImage(this)">
    </div>

    <!-- User Name & Verified Patient Badge -->
    <h2 style="color:#fff; font-size:1.35rem; font-weight:800; margin:0;"><%= (user && user.full_name) ? user.full_name : 'Alex Johnson' %></h2>
    
    <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin: 10px 0 12px; flex-wrap:wrap;">
        <span class="role-tag tag-doctor" style="background:rgba(14,165,233,0.15); color:#38bdf8; text-transform:uppercase; font-size:0.75rem;"><%= (user && user.role) ? user.role : 'PATIENT' %></span>
        <span style="background:rgba(34,197,94,0.15); color:#4ade80; border:1px solid rgba(34,197,94,0.3); font-size:0.75rem; font-weight:800; padding:3px 10px; border-radius:20px; display:inline-flex; align-items:center; gap:4px;">
            <span style="font-size:0.7rem;">✓</span> Verified Patient
        </span>
    </div>

    <!-- Contact & Medical Identifiers -->
    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); border-radius:12px; padding:12px; margin-bottom:18px; text-align:left; display:flex; flex-direction:column; gap:6px;">
        <div style="display:flex; justify-content:space-between; font-size:0.8rem;">
            <span style="color:#94a3b8; font-weight:600;">Email:</span>
            <span style="color:#fff; font-weight:700;"><%= (user && user.email) ? user.email : 'patient@pulsex.health' %></span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:0.8rem;">
            <span style="color:#94a3b8; font-weight:600;">Phone:</span>
            <span style="color:#fff; font-weight:700;"><%= (user && user.phone) ? user.phone : '+1 555 0192' %></span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:0.8rem;">
            <span style="color:#94a3b8; font-weight:600;">Blood Group:</span>
            <span style="color:#f87171; font-weight:800;"><%= (user && user.blood_group) ? user.blood_group : 'O+' %></span>
        </div>
    </div>

    <!-- Action Buttons with Hover Effects -->
    <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/profile" class="btn-primary btn-profile-hover" style="padding:12px; border-radius:12px; font-weight:800; width:100%; text-decoration:none; text-align:center; box-sizing:border-box; transition:all 0.25s ease;">View / Edit Profile</a>
        <button class="btn-secondary" style="padding:11px; border-radius:12px; background:rgba(255,255,255,0.06); color:#fff; border:1px solid rgba(255,255,255,0.1); width:100%; cursor:pointer; font-weight:700; transition:all 0.25s ease;" onclick="openChangePasswordModal()">Change Password</button>
        <a href="/api/auth/logout" class="btn-dash-sos" style="padding:11px; border-radius:12px; text-decoration:none; text-align:center; font-size:0.88rem; margin-top:4px; font-weight:700;">Sign Out</a>
    </div>
</div>
