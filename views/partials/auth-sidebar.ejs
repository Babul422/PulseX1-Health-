<!-- REUSABLE AUTHENTICATED USER PROFILE SIDEBAR -->
<div class="auth-sidebar-card">
    <div class="avatar-wrapper">
        <img id="avatarImage" src="<%= (user && user.avatar_url) ? user.avatar_url : '/images/default-avatar.png' %>" alt="Profile Picture" class="avatar-img" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent((user && user.full_name) ? user.full_name : 'User') %>&background=0ea5e9&color=fff&size=140'">
        <label for="avatarInput" class="avatar-upload-btn" title="Upload Profile Picture">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        </label>
        <input type="file" id="avatarInput" accept="image/*" style="display:none;" onchange="uploadAvatarImage(this)">
    </div>

    <h2 style="color:#fff; font-size:1.4rem; font-weight:800; margin:0;"><%= (user && user.full_name) ? user.full_name : 'Alex Johnson' %></h2>
    <div style="margin: 8px 0;">
        <span class="role-tag tag-doctor" style="background:rgba(14,165,233,0.15); color:#38bdf8; text-transform:uppercase;"><%= (user && user.role) ? user.role : 'PATIENT' %></span>
    </div>
    <p style="color:#94a3b8; font-size:0.85rem; margin: 4px 0;"><%= (user && user.email) ? user.email : 'patient@pulsex.health' %></p>
    <p style="color:#64748b; font-size:0.85rem; margin-top:2px;"><%= (user && user.phone) ? user.phone : '+1 555 0192' %></p>

    <div style="margin-top:24px; display:flex; flex-direction:column; gap:10px;">
        <a href="/profile" class="btn-primary" style="padding:10px; border-radius:10px; font-weight:700; width:100%; text-decoration:none; text-align:center;">View / Edit Profile</a>
        <button class="btn-secondary" style="padding:10px; border-radius:10px; background:rgba(255,255,255,0.06); color:#fff; border:none; width:100%; cursor:pointer;" onclick="openChangePasswordModal()">Change Password</button>
        <a href="/api/auth/logout" class="btn-dash-sos" style="padding:10px; border-radius:10px; text-decoration:none; text-align:center; font-size:0.9rem; margin-top:6px;">Sign Out</a>
    </div>
</div>
