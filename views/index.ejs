<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PulseX - AI-Powered Emergency Healthcare Platform</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <%- include('partials/navbar') %>

    <!-- ================= HERO SECTION ================= -->

    <section class="hero" id="home">

        <div class="hero-left">

            <div class="hero-badge-container">
                <div class="hero-badge">
                    <span class="badge-icon">✨</span> Introducing PulseX AI • v1.0 • Live
                </div>
            </div>

            <h1>
                AI-Powered
                <br>
                <span class="gradient-text">Emergency Healthcare</span>
                <br>
                Platform
            </h1>

            <p class="hero-description">
                Connect patients, hospitals, ambulances, blood banks and doctors in one intelligent platform — with real-time routing, live bed availability, and AI triage that saves critical minutes.
            </p>

            <div class="hero-buttons">

                <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/dashboard/<%= user.role || 'patient' %>" class="btn-primary" style="padding: 16px 32px; font-size: 1.1rem; font-weight: 800;">
                        Go to Dashboard
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>

                    <a href="/profile" class="btn-secondary">
                        👤 View Profile
                    </a>
                <% } else { %>
                    <a href="/signup" class="btn-primary">
                        Get Started
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>

                    <a href="#services" class="btn-secondary">
                        <svg class="btn-play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polygon points="10 8 16 12 10 16 10 8"></polygon>
                        </svg>
                        Explore Features
                    </a>
                <% } %>

            </div>

        </div>



        <div class="hero-right">

            <div class="hero-dashboard">
                
                <!-- Background Grid & Glows -->
                <div class="dashboard-grid"></div>
                <div class="dashboard-glow bg-blue"></div>
                <div class="dashboard-glow bg-emerald"></div>

                <!-- Central Human Body Vector -->
                <div class="central-torso">
                    <svg viewBox="0 0 320 320" class="torso-svg">
                        <!-- Torso outline -->
                        <path d="M160,20 C180,20 200,35 200,60 C200,90 220,105 240,110 C260,115 280,135 280,165 L270,320 L50,320 L40,165 C40,135 60,115 80,110 C100,105 120,90 120,60 C120,35 140,20 160,20 Z" fill="none" stroke="rgba(14, 165, 233, 0.12)" stroke-width="1.5" />
                        <!-- Heart pulse glow -->
                        <circle cx="160" cy="140" r="16" fill="rgba(16, 185, 129, 0.12)" />
                        <circle cx="160" cy="140" r="6" fill="#10b981" />
                        <!-- Glowing pulse rings -->
                        <circle cx="160" cy="140" r="28" fill="none" stroke="rgba(16, 185, 129, 0.25)" stroke-width="1.5" stroke-dasharray="3 3">
                            <animate attributeName="r" from="15" to="45" dur="2.5s" repeatCount="indefinite" />
                            <animate attributeName="opacity" from="1" to="0" dur="2.5s" repeatCount="indefinite" />
                        </circle>
                        <circle cx="160" cy="140" r="48" fill="none" stroke="rgba(14, 165, 233, 0.15)" stroke-width="1" />
                    </svg>
                </div>

                <!-- Panel 1: Cardiac Analysis (Top-Left) -->
                <div class="dashboard-panel panel-cardiac">
                    <span class="panel-tag">AI-Powered Cardiac Analysis</span>
                    <div class="cardiac-flex">
                        <div class="cardiac-left">
                            <span class="pulse-rate">72 <span>BPM</span></span>
                            <!-- Animated ECG SVG -->
                            <svg class="ecg-line" viewBox="0 0 120 40">
                                <path d="M0,20 Q15,20 20,20 L25,10 L30,30 L35,20 L45,20 Q60,20 65,20 L70,10 L75,30 L80,20 L90,20 Q105,20 120,20" fill="none" stroke="#10b981" stroke-width="2" />
                            </svg>
                        </div>
                        <div class="cardiac-right">
                            <div class="progress-ring">
                                <svg width="40" height="40">
                                    <circle cx="20" cy="20" r="16" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="3" />
                                    <circle cx="20" cy="20" r="16" fill="none" stroke="#0ea5e9" stroke-width="3" stroke-dasharray="100" stroke-dashoffset="15" />
                                </svg>
                                <span class="ring-value">98%</span>
                            </div>
                            <span class="ring-label">Heart Score</span>
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Hospital Network (Bottom-Left) -->
                <div class="dashboard-panel panel-hospital">
                    <div class="hospital-flex">
                        <div class="hospital-isometric">
                            <svg viewBox="0 0 40 40" class="hospital-building">
                                <polygon points="20,5 35,12 20,19 5,12" fill="#0f2235" stroke="rgba(0,180,255,0.4)" stroke-width="1" />
                                <polygon points="5,12 20,19 20,35 5,28" fill="#0b1724" stroke="rgba(0,180,255,0.4)" stroke-width="1" />
                                <polygon points="35,12 20,19 20,35 35,28" fill="#13283f" stroke="rgba(0,180,255,0.4)" stroke-width="1" />
                                <path d="M20,11 v6 M17,14 h6" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="hospital-status">
                            <span class="status-title">Hospital Network</span>
                            <span class="status-subtitle">Connected</span>
                            <span class="beds-count">24 Beds Available</span>
                        </div>
                    </div>
                </div>

                <!-- Panel 3: Patient Overview & Metrics (Top-Right) -->
                <div class="dashboard-panel panel-patient">
                    <span class="panel-section-title">Patient Overview</span>
                    <div class="patient-grid">
                        <div><span>ID:</span> 0847192</div>
                        <div><span>Age:</span> 56</div>
                        <div><span>Gender:</span> Male</div>
                        <div><span>Status:</span> Stable</div>
                    </div>
                    <hr class="panel-divider">
                    <span class="panel-section-title text-emerald">Health Metrics</span>
                    <div class="metrics-list">
                        <div class="metric-row">
                            <span>Blood Pressure</span>
                            <span class="metric-val">120/80 mmHg</span>
                        </div>
                        <div class="metric-row">
                            <span>Oxygen Sat.</span>
                            <span class="metric-val text-emerald">98%</span>
                        </div>
                        <div class="metric-row">
                            <span>Respiratory Rate</span>
                            <span class="metric-val">16 rpm</span>
                        </div>
                        <div class="metric-row">
                            <span>Body Temp.</span>
                            <span class="metric-val">36.6 °C</span>
                        </div>
                    </div>
                    <svg class="patient-drop-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                    </svg>
                </div>

                <!-- Panel 4: Emergency Response Map Routing (Bottom-Right) -->
                <div class="dashboard-panel panel-route">
                    <span class="panel-section-title">Emergency Response</span>
                    <div class="route-map-container">
                        <svg class="route-map-svg" viewBox="0 0 150 60">
                            <line x1="0" y1="10" x2="150" y2="10" stroke="rgba(255,255,255,0.02)" />
                            <line x1="0" y1="30" x2="150" y2="30" stroke="rgba(255,255,255,0.02)" />
                            <line x1="0" y1="50" x2="150" y2="50" stroke="rgba(255,255,255,0.02)" />
                            <path d="M10,50 L40,50 L60,20 L110,20 L130,10" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="4" stroke-linecap="round" />
                            <path d="M10,50 L40,50 L60,20 L110,20 L130,10" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" id="route-path" />
                            <circle cx="130" cy="10" r="4" fill="#10b981" />
                            <circle cx="10" cy="50" r="5" fill="#ef4444">
                                <animateMotion dur="4s" repeatCount="indefinite" path="M10,50 L40,50 L60,20 L110,20 L130,10" />
                            </circle>
                        </svg>
                    </div>
                    <div class="route-info-row">
                        <div>
                            <span>ETA</span>
                            <strong>8 min</strong>
                        </div>
                        <div>
                            <span>Distance</span>
                            <strong>2.4 km</strong>
                        </div>
                        <a href="#" class="btn-route">Route Option</a>
                    </div>
                </div>

                <!-- Overlay Card 1: ETA -->
                <div class="hud-floating-card hud-card-eta">
                    <span class="hud-pulse-dot"></span>
                    <div class="card-details">
                        <span class="card-title">ETA</span>
                        <span class="card-value">4:12 min</span>
                    </div>
                </div>

                <!-- Overlay Card 2: AI Triage -->
                <div class="hud-floating-card hud-card-triage">
                    <svg class="warning-triangle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    <div class="card-details">
                        <span class="card-title">AI Triage</span>
                        <span class="card-value text-red">Critical</span>
                    </div>
                </div>

            </div>

        </div>

    </section>

    <!-- ================= HERO STATS ROW ================= -->
    
    <div class="hero-stats-section">
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number" data-target="2480">0</span>
                <span class="stat-label">Active Ambulances</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" data-target="9120">0</span>
                <span class="stat-label">Verified Doctors</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" data-target="640">0</span>
                <span class="stat-label">Partner Hospitals</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" data-target="184000" data-format="k">0</span>
                <span class="stat-label">Dispatched Emergencies</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" data-target="1200000" data-format="m">0</span>
                <span class="stat-label">Lives Saved</span>
            </div>
        </div>
    </div>


    <!-- ================= FEATURES SECTION ===========    <section class="features" id="services">

        <div class="section-tag">— FEATURE SHOWCASE</div>
        <h2 class="reveal">Everything critical care<br>needs, in one platform.</h2>
        <p class="section-subtitle reveal">A modular, intelligent stack built for hospitals, doctors, patients, blood banks, and emergency responders.</p>

        <!-- COMPACT SUMMARY ROW -->
        <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin: 20px 0 32px 0;">
            <span style="background:rgba(14,165,233,0.12); color:#38bdf8; border:1px solid rgba(14,165,233,0.25); padding:6px 16px; border-radius:20px; font-size:0.85rem; font-weight:700;">⚡ 8 Core Modules</span>
            <span style="background:rgba(168,85,247,0.12); color:#c084fc; border:1px solid rgba(168,85,247,0.25); padding:6px 16px; border-radius:20px; font-size:0.85rem; font-weight:700;">🤖 AI Powered Triage</span>
            <span style="background:rgba(34,197,94,0.12); color:#4ade80; border:1px solid rgba(34,197,94,0.25); padding:6px 16px; border-radius:20px; font-size:0.85rem; font-weight:700;">🌐 Real-Time Network</span>
            <span style="background:rgba(239,68,68,0.12); color:#f87171; border:1px solid rgba(239,68,68,0.25); padding:6px 16px; border-radius:20px; font-size:0.85rem; font-weight:700;">🚨 24/7 Emergency Support</span>
        </div>

        <!-- FEATURE SHOWCASE GRID -->
        <div class="feature-showcase-grid">

            <!-- 1. FEATURED CARD (SPANS 2 COLUMNS) - AI HEALTH ASSISTANT -->
            <a href="#ai-assistant" class="feature-showcase-card featured-card reveal">
                <span class="showcase-badge badge-ai">🤖 AI TRIAGE v2.5</span>
                <div>
                    <div class="icon-wrapper" style="width:60px; height:60px; background:rgba(14,165,233,0.2); border-color:rgba(14,165,233,0.4);">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:28px; height:28px;">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            <circle cx="12" cy="16" r="1"></circle>
                        </svg>
                    </div>
                    <h3 style="font-size:1.4rem; font-weight:800; color:#fff; margin-bottom:8px;">PulseX AI Clinical Triage Assistant</h3>
                    <p style="color:#cbd5e1; font-size:0.95rem; line-height:1.6; max-width:540px;">24/7 medical triage and evidence-based symptom analysis powered by Google Gemini 2.5 Flash. Delivers instant risk urgency rating, recommended specialist department, first-aid steps, and red-flag alerts.</p>
                    <div style="margin-top:14px; display:flex; gap:16px; align-items:center;">
                        <span style="color:#4ade80; font-weight:700; font-size:0.88rem;">✓ 98% Triage Accuracy</span>
                        <span style="color:#94a3b8; font-size:0.85rem;">• Instant Analysis</span>
                    </div>
                </div>
                <div class="card-action-link" style="font-size:0.95rem; margin-top:20px;">
                    Try AI Triage Assistant <span style="font-size:1.1rem;">→</span>
                </div>
            </a>

            <!-- 2. SMART HOSPITAL FINDER -->
            <a href="#hospitals" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-live">LIVE</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Smart Hospital Finder</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">Locate best-fit hospitals by specialty, distance and live bed load.</p>
                    <div style="color:#4ade80; font-weight:700; font-size:0.85rem; margin-top:10px;">📊 640+ Hospitals Connected</div>
                </div>
                <div class="card-action-link">
                    Find Hospitals <span>→</span>
                </div>
            </a>

            <!-- 3. REAL-TIME BED AVAILABILITY -->
            <a href="#hospitals" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-live">LIVE</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M2 4v16M2 11h20M22 4v16M2 17h20M6 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Real-Time Bed Tracker</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">Live ICU, trauma ward and operating theater bed counts.</p>
                    <div style="color:#38bdf8; font-weight:700; font-size:0.85rem; margin-top:10px;">🛏️ 1,420+ Beds Available</div>
                </div>
                <div class="card-action-link">
                    Track Beds <span>→</span>
                </div>
            </a>

            <!-- 4. AMBULANCE TRACKING -->
            <a href="#ambulances" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-247">24/7</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Ambulance Fleet GPS</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">GPS routing with traffic-aware ETA and paramedic telemetry.</p>
                    <div style="color:#fbbf24; font-weight:700; font-size:0.85rem; margin-top:10px;">⚡ 4.2 Min Avg Response</div>
                </div>
                <div class="card-action-link">
                    Track Ambulances <span>→</span>
                </div>
            </a>

            <!-- 5. BLOOD BANK MATCHING -->
            <a href="#blood-bank" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-new">NEW</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M12 2a9 9 0 0 0-9 9c0 5 9 11 9 11s9-6 9-11a9 9 0 0 0-9-9z"></path>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Blood Bank Repository</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">Live inventory matching and instant dispatch for critical cases.</p>
                    <div style="color:#f87171; font-weight:700; font-size:0.85rem; margin-top:10px;">🩸 90 Blood Units Online</div>
                </div>
                <div class="card-action-link">
                    View Inventory <span>→</span>
                </div>
            </a>

            <!-- 6. LIVE GEOLOCATION SOS -->
            <a href="#emergency" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-critical">CRITICAL</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <path d="M12 8v4"></path>
                            <path d="M12 16h.01"></path>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Live Geolocation SOS</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">One-tap emergency dispatch broadcasting live GPS coordinates.</p>
                    <div style="color:#f87171; font-weight:700; font-size:0.85rem; margin-top:10px;">🚨 Instant SOS Dispatch</div>
                </div>
                <div class="card-action-link">
                    Trigger SOS <span>→</span>
                </div>
            </a>

            <!-- 7. VOLUNTEER NETWORK -->
            <a href="#volunteers" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-247">24/7</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">Volunteer Network</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">Crowdsourced EMT and CPR-certified first-responder network.</p>
                    <div style="color:#c084fc; font-weight:700; font-size:0.85rem; margin-top:10px;">🤝 120+ Active Responders</div>
                </div>
                <div class="card-action-link">
                    Connect Responders <span>→</span>
                </div>
            </a>

            <!-- 8. EHR INTEGRATION -->
            <a href="/profile" class="feature-showcase-card reveal">
                <span class="showcase-badge badge-live">SECURE</span>
                <div>
                    <div class="icon-wrapper">
                        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px; height:24px;">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                    </div>
                    <h3 style="font-size:1.15rem; font-weight:700; color:#fff; margin-bottom:6px;">EHR Records Integration</h3>
                    <p style="color:#94a3b8; font-size:0.88rem;">Encrypted medical record sharing for accelerated ER intake.</p>
                    <div style="color:#38bdf8; font-weight:700; font-size:0.85rem; margin-top:10px;">🔒 Encrypted Health Vault</div>
                </div>
                <div class="card-action-link">
                    Open Records <span>→</span>
                </div>
            </a>

        </div>

    </section>

    <!-- ================= SMART HOSPITAL COMMAND CENTER ================= -->
    <section class="features" id="hospitals" style="padding-top:60px;">
        <div class="section-tag">— HOSPITAL COMMAND CENTER</div>
        <h2 class="reveal">Real-Time Bed Tracker & Hospital Directory</h2>
        <p class="section-subtitle reveal">Live ICU bed load telemetry, emergency room capacity, and instant bed reservation across partner hospitals.</p>

        <!-- 1. SUMMARY STATISTICS ROW -->
