                        <path d="M160,20 C180,20 200,35 200,60 C200,90 220,105 240,110 C260,115 280,135 280,165 L270,320 L50,320 L40,165 C40,135 60,115 80,110 C100,105 120,90 120,60 C120,35 140,20 160,20 Z" fill="none" stroke="rgba(14, 165, 233, 0.12)" stroke-width="1.5" />
                        <!-- Heart pulse glow -->
                        <circle cx="160" cy="140" r="16" fill="rgba(16, 185, 129, 0.12)" />
                        <circle cx="160" cy="140" r="6" fill="#10b981" />
