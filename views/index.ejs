    <script src="/js/script.js"></script>
    <script>
        // 1. Emergency SOS Workflow
        async function triggerSOSWorkflow() {
            if (!confirm("🚨 Emergency SOS Trigger\nDo you want to dispatch a cardiac ambulance and request immediate hospital bed reservation?")) return;

            try {
                const res = await fetch('/api/emergency/sos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        emergency_type: 'Acute Emergency SOS',
                        priority: 'critical',
                        location: 'Current GPS Location (Simulated)'
                    })
                });

                const data = await res.json();
                if (data.success && data.data && data.data.tracking_url) {
                    window.location.href = data.data.tracking_url;
                } else {
                    window.location.href = '/dashboard/patient';
                }
            } catch (err) {
                window.location.href = '/dashboard/patient';
            }
        }

        // 2. Generic Modal Helpers
        function showGenericModal(title, message) {
            document.getElementById('genericModalTitle').innerText = title;
            document.getElementById('genericModalBody').innerText = message;
            const modal = document.getElementById('genericModal');
            modal.style.display = 'flex';
        }
        function closeGenericModal() {
            document.getElementById('genericModal').style.display = 'none';
        }

        // 3. Hospital Search & Filter & Command Actions
        function filterHospitals() {
            const query = (document.getElementById('hospitalSearchInput')?.value || '').toLowerCase().trim();
            const cityFilter = (document.getElementById('hospitalCityFilter')?.value || '').toLowerCase().trim();
            const specialtyFilter = (document.getElementById('hospitalSpecialtyFilter')?.value || '').toLowerCase().trim();
            const emergencyOnly = document.getElementById('hospitalEmergencyToggle')?.checked || false;

            document.querySelectorAll('.hospital-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const city = (item.getAttribute('data-city') || '').toLowerCase();
                const specialty = (item.getAttribute('data-specialty') || '').toLowerCase();
                const isEmergency = item.getAttribute('data-emergency') === 'true';

                const matchesQuery = !query || name.includes(query) || city.includes(query) || specialty.includes(query);
                const matchesCity = !cityFilter || city.includes(cityFilter);
                const matchesSpecialty = !specialtyFilter || specialty.includes(specialtyFilter);
                const matchesEmergency = !emergencyOnly || isEmergency;

                const matches = matchesQuery && matchesCity && matchesSpecialty && matchesEmergency;
                item.style.display = matches ? '' : 'none';
            });
        }

        function useCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        showGenericModal(
                            '📍 Location Detected',
                            `GPS Coordinates: (${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}).\nNearby hospitals sorted by closest proximity.`
                        );
                    },
                    () => {
                        showGenericModal('📍 Proximity Filter Active', 'Nearby hospitals sorted by closest distance from your current location.');
                    }
                );
            } else {
                showGenericModal('📍 Proximity Filter Active', 'Nearby hospitals sorted by closest distance from your current location.');
            }
        }

        function getHospitalDirections(hospitalName) {
            showGenericModal(
                `🗺️ Route Navigation: ${hospitalName}`,
                `Live GPS traffic-aware route generated.\nEstimated Arrival Time: 6–10 minutes with emergency priority dispatch.`
            );
        }

        function callHospitalNumber(phone) {
            showGenericModal(
                `📞 Direct Hospital Emergency Line`,
                `Connecting call to Emergency Desk at ${phone}.\nLine Status: Connected.`
            );
        }

        function openHospitalModal(name, beds, icu, phone) {
            showGenericModal(
                '🏥 Emergency Bed Reserved',
                `Reserved bed at ${name}.\nAvailable: ${beds} | ICU: ${icu}\nEmergency Desk: ${phone}`
            );
        }

        // 4. Doctor Search & Multi-Filter
        function filterDoctors() {
            const query = (document.getElementById('doctorSearchInput')?.value || '').toLowerCase();
            const specialtyFilter = (document.getElementById('doctorSpecialtyFilter')?.value || '').toLowerCase();
            const hospitalFilter = (document.getElementById('doctorHospitalFilter')?.value || '').toLowerCase();
            const ratingFilter = parseFloat(document.getElementById('doctorRatingFilter')?.value || '0');
            const feeFilter = document.getElementById('doctorFeeFilter')?.value || '';
            const availOnly = document.getElementById('doctorAvailableToggle')?.checked || false;

            document.querySelectorAll('.doctor-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const spec = (item.getAttribute('data-specialty') || '').toLowerCase();
                const hosp = (item.getAttribute('data-hospital') || '').toLowerCase();
                const rating = parseFloat(item.getAttribute('data-rating') || '0');
                const fee = parseFloat(item.getAttribute('data-fee') || '0');
                const avail = item.getAttribute('data-available') === 'true';

                let matchesQuery = !query || name.includes(query) || spec.includes(query) || hosp.includes(query);
                let matchesSpec = !specialtyFilter || spec.includes(specialtyFilter);
                let matchesHosp = !hospitalFilter || hosp.includes(hospitalFilter);
                let matchesRating = !ratingFilter || rating >= ratingFilter;
                let matchesAvail = !availOnly || avail;

                let matchesFee = true;
                if (feeFilter === 'under150') matchesFee = fee <= 150;
                else if (feeFilter === '150to200') matchesFee = fee >= 150 && fee <= 200;
                else if (feeFilter === 'above200') matchesFee = fee > 200;

                const isMatch = matchesQuery && matchesSpec && matchesHosp && matchesRating && matchesAvail && matchesFee;
                item.style.display = isMatch ? 'flex' : 'none';
            });
        }

        function useCurrentLocationDoctors() {
            showGenericModal('📍 Proximity Specialist Filter', 'Filter applied! Verified doctors sorted by nearest distance to your current GPS location.');
        }

        function openDoctorChat(docName) {
            showGenericModal('💬 Direct Consultation Chat', `Initiating encrypted instant chat with ${docName}.\nConnecting to secure Telehealth channel...`);
        }

        function openDoctorProfile(name, spec, exp, fee, license) {
            document.getElementById('profName').innerText = name;
            document.getElementById('profSpecialty').innerText = spec;
            document.getElementById('profExp').innerText = `Experience: ${exp} • License: ${license}`;
            document.getElementById('profFee').innerText = `Consultation Fee: ${fee}`;
            document.getElementById('profBookBtn').onclick = () => {
                closeDoctorProfileModal();
                openBookingModal(name, 'doc-01');
            };
            document.getElementById('doctorProfileModal').style.display = 'flex';
        }
        function closeDoctorProfileModal() {
            document.getElementById('doctorProfileModal').style.display = 'none';
        }

        // 5. Appointment Booking Modal & Submission
        let currentBookingDoctor = '';
        function openBookingModal(docName, docId) {
            currentBookingDoctor = docName;
            document.getElementById('bookDocName').innerText = docName;
            document.getElementById('bookingModal').style.display = 'flex';
        }
        function closeBookingModal() {
            document.getElementById('bookingModal').style.display = 'none';
        }

        async function submitDoctorBooking() {
            const dateVal = document.getElementById('bookDateTime').value;
            const reason = document.getElementById('bookReason').value;
            closeBookingModal();

            try {
                await fetch('/api/appointments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctor_name: currentBookingDoctor, appointment_date: dateVal, reason })
                });
            } catch(e) {}

            showGenericModal(
                '✓ Appointment Confirmed',
                `Your appointment with ${currentBookingDoctor} is confirmed for ${dateVal || 'Tomorrow, 10:00 AM'}.\nReason: ${reason || 'Consultation'}`
            );
        }

        // 6. Blood Bank Request
        function requestBloodUnit() {
            const group = prompt("Enter Blood Group needed (e.g. A+, O-, B+):", "O-");
            if (!group) return;
            showGenericModal(
                '🩸 Blood Request Dispatched',
                `Emergency request for ${group} blood units sent to Metro Blood Repository. Matching hospital units reserved.`
            );
        }

        // 7. Ambulance Dispatch Simulator & Command Center Controls
        function dispatchAmbulanceProgress(vehicle) {
            showGenericModal("🚨 Emergency Dispatch Initiated", `Locking GPS vector for unit ${vehicle}...\nConnecting to emergency broadcast frequency.`);
            setTimeout(() => {
                showGenericModal(
                    "🚑 Ambulance Dispatched & En Route!",
                    `Unit ${vehicle} has confirmed dispatch!\n\nDriver: On-duty Specialist\nStatus: Emergency Lights & Siren Engaged\nETA: 3.5 Minutes (Optimal Traffic Route)`
                );
            }, 1000);
        }

        function trackAmbulanceLive(vehicleId) {
            showGenericModal(
                `📡 Live Telemetry Feed — ${vehicleId}`,
                `GPS Coordinates: 40.7128° N, 74.0060° W\nSpeed: 62 km/h (Emergency Mode)\nSatellite Sync: 99.8% Signal Lock\nRoute Status: Priority Signal Override Enabled`
            );
        }

        // 7. Interactive Fleet GPS Map & Dispatch Telemetry System
        window.initGoogleMapsEngine = function() {
            if (window.pulseXMapSystem) {
                window.pulseXMapSystem.init('liveFleetInteractiveMap');
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            // Fallback initialization if Google Maps callback hasn't fired
            setTimeout(() => {
                if (window.pulseXMapSystem && !window.pulseXMapSystem.map) {
                    window.pulseXMapSystem.init('liveFleetInteractiveMap');
                }
            }, 1200);
        });

        // 8. AI Assistant Chat Evaluation & Clinical Triage Controls
        function filterSymptomCategory(category, btnElement) {
            const btns = document.querySelectorAll('.symptom-cat-btn');
            btns.forEach(b => b.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');

            const chips = document.querySelectorAll('.symptom-chip-item');
            chips.forEach(chip => {
                if (category === 'all') {
                    chip.style.display = 'inline-flex';
                } else {
                    const catClass = `cat-${category}`;
                    if (chip.classList.contains(catClass)) {
                        chip.style.display = 'inline-flex';
                    } else {
                        chip.style.display = 'none';
                    }
                }
            });
        }

        async function sendAIChat(symptomsText) {
            document.getElementById('aiChatInput').value = symptomsText;
            submitAIChatForm();
        }

        async function submitAIChatForm() {
            const input = document.getElementById('aiChatInput');
            const chatOutput = document.getElementById('aiChatOutput');
            const submitBtn = document.getElementById('aiSubmitBtn');
            const btnText = document.getElementById('aiBtnText');
            const btnSpinner = document.getElementById('aiBtnSpinner');

            const text = input.value.trim();
            if (!text) return;

            // Loading state: Disable button & show initial animated steps
            if (submitBtn) submitBtn.disabled = true;
            if (btnText) btnText.innerText = 'Analyzing Triage...';
            if (btnSpinner) btnSpinner.style.display = 'inline-block';

            chatOutput.style.display = 'block';
            chatOutput.innerHTML = `
                <div class="ai-analysis-anim-box">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                        <div style="color:#fff; font-weight:800; font-size:1.05rem;">🧠 PulseX Clinical AI Processing Triage</div>
                        <div style="color:#38bdf8; font-size:0.8rem; font-weight:700;">Google Gemini 2.0 Flash</div>
                    </div>

                    <div class="anim-step-row active" id="animStep1">
                        <span class="anim-step-dot"></span>
                        <span>Step 1/4: 🔍 Analyzing Symptoms & Vital Signals...</span>
                    </div>
                    <div class="anim-step-row" id="animStep2">
                        <span class="anim-step-dot"></span>
                        <span>Step 2/4: ⚡ Assessing Clinical Urgency & Emergency Risk...</span>
                    </div>
                    <div class="anim-step-row" id="animStep3">
                        <span class="anim-step-dot"></span>
                        <span>Step 3/4: 🏥 Matching Specialist & Hospital Capacity...</span>
                    </div>
                    <div class="anim-step-row" id="animStep4">
                        <span class="anim-step-dot"></span>
                        <span>Step 4/4: 📋 Compiling Actionable Recommendation...</span>
                    </div>

                    <div style="width:100%; height:6px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden; margin-top:8px;">
                        <div id="aiProgressBar" style="width:25%; height:100%; background:linear-gradient(90deg, #38bdf8, #4ade80); transition:width 0.4s ease;"></div>
                    </div>
                </div>
            `;

            // Step animation timers
            setTimeout(() => {
                const s1 = document.getElementById('animStep1');
                const s2 = document.getElementById('animStep2');
                const bar = document.getElementById('aiProgressBar');
                if (s1 && s2 && bar) {
                    s1.classList.remove('active');
                    s1.classList.add('completed');
                    s2.classList.add('active');
                    bar.style.width = '50%';
                }
            }, 350);

            setTimeout(() => {
                const s2 = document.getElementById('animStep2');
                const s3 = document.getElementById('animStep3');
                const bar = document.getElementById('aiProgressBar');
                if (s2 && s3 && bar) {
                    s2.classList.remove('active');
                    s2.classList.add('completed');
                    s3.classList.add('active');
                    bar.style.width = '75%';
                }
            }, 700);

            setTimeout(() => {
                const s3 = document.getElementById('animStep3');
                const s4 = document.getElementById('animStep4');
                const bar = document.getElementById('aiProgressBar');
                if (s3 && s4 && bar) {
                    s3.classList.remove('active');
                    s3.classList.add('completed');
                    s4.classList.add('active');
                    bar.style.width = '95%';
                }
            }, 1050);

            try {
                const res = await fetch('/api/ai/triage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ symptoms: text })
                });

                const result = await res.json();
                const data = result.data || {};

                // Delay rendering result slightly to finish 4-step visual flow
                await new Promise(r => setTimeout(r, 1200));

                const urgency = (data.urgency || 'MEDIUM').toUpperCase();
                const isEmergency = urgency === 'EMERGENCY' || urgency === 'HIGH' || data.should_call_ambulance;

                let urgencyColor = '#4ade80'; // Green LOW
                let urgencyBg = 'rgba(34,197,94,0.12)';
                let urgencyBorder = 'rgba(34,197,94,0.35)';
                let urgencyIcon = '🌱';

                if (urgency === 'MEDIUM') {
                    urgencyColor = '#facc15';
                    urgencyBg = 'rgba(234,179,8,0.12)';
                    urgencyBorder = 'rgba(234,179,8,0.35)';
                    urgencyIcon = '⚡';
                } else if (urgency === 'HIGH') {
                    urgencyColor = '#f97316';
                    urgencyBg = 'rgba(249,115,22,0.15)';
                    urgencyBorder = 'rgba(249,115,22,0.4)';
                    urgencyIcon = '⚠️';
                } else if (urgency === 'EMERGENCY' || urgency === 'CRITICAL') {
                    urgencyColor = '#f87171';
                    urgencyBg = 'rgba(239,68,68,0.18)';
                    urgencyBorder = 'rgba(239,68,68,0.5)';
                    urgencyIcon = '🚨';
                }

                const confidencePct = Math.round((data.confidence || 0.94) * 100);

                let html = `
                    <div style="display:flex; flex-direction:column; gap:20px;">
                        
                        <!-- 1. URGENCY LEVEL & CONFIDENCE HEADER CARD -->
                        <div style="background:${urgencyBg}; border:1px solid ${urgencyBorder}; border-radius:18px; padding:22px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; box-shadow:0 8px 25px rgba(0,0,0,0.3);">
                            <div>
                                <span style="background:${urgencyColor}; color:#0a0f1d; font-weight:900; font-size:0.8rem; padding:5px 14px; border-radius:20px; text-transform:uppercase; letter-spacing:0.05em; display:inline-flex; align-items:center; gap:6px;">${urgencyIcon} ${urgency} URGENCY</span>
                                <h3 style="color:#fff; margin-top:10px; font-size:1.25rem; font-weight:800;">${data.summary || 'Clinical Triage Evaluation'}</h3>
                            </div>
                            <div style="text-align:right;">
                                <div style="color:var(--color-text-gray); font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">AI Confidence Score</div>
                                <div style="color:${urgencyColor}; font-size:1.6rem; font-weight:900; margin-top:2px;">${confidencePct}%</div>
                            </div>
                        </div>

                        <!-- 2. POSSIBLE CONDITIONS & RECOMMENDED SPECIALIST CARDS -->
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:18px;">
                            
                            <div style="background:rgba(15,23,42,0.7); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
                                <div style="color:#38bdf8; font-weight:800; font-size:0.92rem; margin-bottom:10px; display:flex; align-items:center; gap:6px;">🩺 Possible Conditions</div>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    ${(data.possible_conditions || ['Symptom Assessment']).map(c => `<span style="background:rgba(56,189,248,0.12); color:#38bdf8; border:1px solid rgba(56,189,248,0.3); padding:5px 12px; border-radius:12px; font-size:0.8rem; font-weight:700;">${c}</span>`).join('')}
                                </div>
                            </div>

                            <div style="background:rgba(15,23,42,0.7); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
                                <div style="color:#4ade80; font-weight:800; font-size:0.92rem; margin-bottom:8px; display:flex; align-items:center; gap:6px;">👨‍⚕️ Recommended Specialist & Department</div>
                                <div style="color:#fff; font-weight:800; font-size:1.05rem;">${data.recommended_specialist || 'General Practitioner'}</div>
                                <div style="color:var(--color-text-gray); font-size:0.85rem; margin-top:3px; font-weight:600;">Department: ${data.recommended_department || 'Outpatient Clinic'}</div>
                            </div>

                        </div>

                        <!-- 3. FIRST-AID & RED FLAGS CARD -->
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:18px;">
                            
                            <div style="background:rgba(15,23,42,0.7); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
                                <div style="color:#4ade80; font-weight:800; font-size:0.92rem; margin-bottom:10px; display:flex; align-items:center; gap:6px;">🩹 Immediate First-Aid Guidance</div>
                                <ul style="margin:0; padding-left:18px; color:#cbd5e1; font-size:0.88rem; line-height:1.6;">
                                    ${(data.first_aid || ['Rest in a comfortable position', 'Stay hydrated', 'Monitor symptoms closely']).map(fa => `<li style="margin-bottom:4px;">${fa}</li>`).join('')}
                                </ul>
                            </div>

                            <div style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.22); border-radius:16px; padding:20px;">
                                <div style="color:#f87171; font-weight:800; font-size:0.92rem; margin-bottom:10px; display:flex; align-items:center; gap:6px;">⚠️ Red Flag Warning Symptoms</div>
                                <ul style="margin:0; padding-left:18px; color:#fca5a5; font-size:0.88rem; line-height:1.6;">
                                    ${(data.red_flags || ['Sudden worsening of symptoms', 'High fever over 103°F', 'Loss of consciousness']).map(rf => `<li style="margin-bottom:4px;">${rf}</li>`).join('')}
                                </ul>
                            </div>

                        </div>

                        <!-- 4. NEARBY HOSPITALS RECOMMENDATION CARD -->
                        <div style="background:rgba(15,23,42,0.7); backdrop-filter:blur(10px); border:1px solid rgba(56,189,248,0.2); border-radius:16px; padding:20px;">
                            <div style="color:#38bdf8; font-weight:800; font-size:0.95rem; margin-bottom:10px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                                <span>🏥 Recommended Nearby Hospitals (Live Bed Availability)</span>
                                <span style="font-size:0.78rem; color:#4ade80; background:rgba(34,197,94,0.12); padding:3px 10px; border-radius:12px; border:1px solid rgba(34,197,94,0.3);">● 3 Hospitals Verified Ready</span>
                            </div>
                            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:8px;">
                                <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:12px;">
                                    <div style="color:#fff; font-weight:800; font-size:0.9rem;">City Care General Hospital</div>
                                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">1.2 km away • 14 ICU Beds Available</div>
                                </div>
                                <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:12px;">
                                    <div style="color:#fff; font-weight:800; font-size:0.9rem;">Apex Trauma Center</div>
                                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">3.5 km away • 8 ICU Beds Available</div>
                                </div>
                            </div>
                        </div>
                `;

                // 5. EMERGENCY WARNING BANNER vs LOW/MEDIUM ACTION BUTTONS
                if (isEmergency) {
                    html += `
                        <div style="background:linear-gradient(135deg, rgba(239,68,68,0.2) 0%, rgba(185,28,28,0.25) 100%); border:2px solid #ef4444; border-radius:18px; padding:22px; margin-top:4px; box-shadow:0 10px 30px rgba(239,68,68,0.2);">
                            <div style="color:#f87171; font-weight:900; font-size:1.15rem; margin-bottom:6px; display:flex; align-items:center; gap:8px;">🚨 CRITICAL ACTION REQUIRED — IMMEDIATE DISPATCH</div>
                            <div style="color:#cbd5e1; font-size:0.9rem; margin-bottom:18px; line-height:1.5;">Symptoms indicate a potential medical emergency. Please trigger instant emergency SOS or dispatch ambulance:</div>
                            
                            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:12px;">
                                <button class="btn-primary" style="background:linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); color:#fff; border:1px solid rgba(248,113,113,0.4); padding:14px; border-radius:12px; font-weight:800; cursor:pointer; font-size:0.9rem; box-shadow:0 4px 15px rgba(220,38,38,0.3);" onclick="triggerSOSWorkflow()">🚑 Trigger Emergency SOS</button>
                                <button class="btn-secondary" style="padding:14px; border-radius:12px; background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); font-weight:800; cursor:pointer; font-size:0.9rem;" onclick="dispatchAmbulanceProgress('Cardiac ICU Unit')">🚑 Dispatch Ambulance</button>
                                <button class="btn-secondary" style="padding:14px; border-radius:12px; background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4); font-weight:800; cursor:pointer; font-size:0.9rem;" onclick="openBookingModal('${data.recommended_specialist || 'Emergency Specialist'}', 'doc-01')">📅 Book Priority Visit</button>
                            </div>

                            <div style="margin-top:16px; font-weight:800; font-size:0.85rem; color:#fca5a5; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                <span>📞 Direct Helpline: 911 / 112</span>
                                <span>|</span>
                                <span>PulseX Hotline: +1 800 555 0199</span>
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div style="background:rgba(56,189,248,0.08); border:1px solid rgba(56,189,248,0.25); border-radius:18px; padding:20px; margin-top:4px;">
                            <div style="color:#38bdf8; font-weight:800; font-size:1.0rem; margin-bottom:6px;">👍 Outpatient Consultation & Action Plan</div>
                            <div style="color:#cbd5e1; font-size:0.88rem; margin-bottom:14px;">Symptoms appear manageable with specialized outpatient consultation:</div>
                            
                            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                                <button class="btn-primary" style="padding:12px 24px; border-radius:12px; font-weight:800; cursor:pointer;" onclick="openBookingModal('${data.recommended_specialist || 'General Medicine Specialist'}', 'doc-01')">📅 Book Specialist Appointment</button>
                                <a href="#doctors" class="btn-secondary" style="padding:12px 20px; border-radius:12px; background:rgba(255,255,255,0.06); color:#fff; text-decoration:none; font-weight:700; display:inline-flex; align-items:center; gap:6px;">👨‍⚕️ View Verified Specialists</a>
                            </div>
                        </div>
                    `;
                }

                // 6. MEDICAL DISCLAIMER NOTICE
                html += `
                        <div style="color:#64748b; font-size:0.76rem; text-align:center; margin-top:12px; border-top:1px solid rgba(255,255,255,0.08); padding-top:12px; line-height:1.5;">
                            🔒 <strong>Medical Disclaimer:</strong> ${data.disclaimer || 'PulseX AI Triage provides preliminary educational guidance powered by Google Gemini and is not a clinical diagnosis. Always consult a certified healthcare professional for medical emergencies.'}
                        </div>

                    </div>
                `;

                chatOutput.innerHTML = html;

            } catch (err) {
                chatOutput.innerHTML = `
                    <div style="background:rgba(239,68,68,0.15); border:1px solid #ef4444; border-radius:16px; padding:20px; color:#f87171;">
                        <strong>⚠️ Triage Service Error:</strong> Failed to complete AI triage analysis. Please check network connectivity or call emergency services directly if in distress.
                    </div>
                `;
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (btnText) btnText.innerText = 'Analyze Clinical Triage';
                if (btnSpinner) btnSpinner.style.display = 'none';
            }
        }

        // 9. Volunteer Network Connection & Profile Modals
        function connectVolunteer(volName) {
            showGenericModal(
                '🤝 First Responder Alert Dispatched',
                `Priority SOS alert sent to volunteer ${volName}.\n\nGPS Proximity Lock: Active (Estimated Arrival: 3.5 Mins)\nDirect Mesh Channel: Connected`
            );
        }

        function viewVolunteerProfile(name, role, hospital, rating, skills) {
            showGenericModal(
                `👨‍⚕️ Responder Profile — ${name}`,
                `Role: ${role}\nAttached Hospital: ${hospital}\nRating: ★ ${rating} (Verified)\nCertifications & Skills: ${skills}\nStatus: Active On-Duty Proximity Mesh`
            );
        }

        function callVolunteerDirect(name, phone) {
            showGenericModal(
                `📞 Direct Responder Comms — ${name}`,
                `Connecting encrypted voice channel to ${name} (${phone})...\n\nPress OK to place direct call or transmit emergency GPS coordinates.`
            );
        }

        // 10. Blood Bank Filter & Actions
        function filterBloodGroupCards() {
            const query = document.getElementById('bloodSearchInput').value.trim().toUpperCase();
            const cards = document.querySelectorAll('.blood-group-item');

            cards.forEach(card => {
                const group = card.getAttribute('data-group').toUpperCase();
                if (!query || group.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function setBloodPillFilter(selectedGroup, btnElement) {
            document.querySelectorAll('#bloodPillFilters .blood-filter-pill').forEach(pill => pill.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');

            const cards = document.querySelectorAll('.blood-group-item');
            cards.forEach(card => {
                const group = card.getAttribute('data-group');
                if (selectedGroup === 'ALL' || group === selectedGroup) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function requestBloodGroupUnit(group) {
            showGenericModal(
                `🩸 Request ${group} Blood Units`,
                `Emergency dispatch initiated for ${group} blood group across 18 connected repositories. Estimated reserve confirmation: 2 minutes.`
            );
        }

        function findNearbyBloodBanks() {
            showGenericModal(
                '🏥 Nearby Blood Bank Repositories',
                `1. Metro Central Blood Bank (1.2 km) - Open 24/7\n2. St. Jude Blood Repository (3.4 km) - Open 24/7\n3. Apex Trauma Blood Center (5.1 km) - Open 24/7`
            );
        }

        function openDonorModal() {
            showGenericModal(
                '🤝 PulseX Blood Donor Registration',
                `Thank you for offering to donate! Your voluntary blood donation saves lives.\n\nPlease confirm your blood type at your nearest PulseX partner hospital or book a donation slot in your profile settings.`
            );
        }

        // 11. Emergency Response Timeline Controls
        const timelineDescriptions = {
            1: "Step 1/6: 🚨 SOS Triggered (0s) — Instant emergency alert broadcast initiated by patient.",
            2: "Step 2/6: 🤖 AI Risk Analysis (15s) — Gemini AI evaluates triage urgency and risk factors.",
            3: "Step 3/6: 🏥 Hospital Selected (30s) — Matching hospital ICU bed reserved automatically.",
            4: "Step 4/6: 🚑 Ambulance Dispatched (45s) — Priority cardiac ICU unit dispatched with siren override.",
            5: "Step 5/6: 📍 Live GPS Tracking (6m) — Satellite telemetry & real-time ETA streamed to care team.",
            6: "Step 6/6: ❤️ Patient Reached Hospital (12m) — Patient admitted into prepped operating theatre."
        };

        function selectTimelineStep(stepNum) {
            const cards = document.querySelectorAll('.timeline-step-card');
            cards.forEach(c => c.classList.remove('active-step'));

            const targetCard = document.querySelector(`.timeline-step-card[data-step="${stepNum}"]`);
            if (targetCard) targetCard.classList.add('active-step');

            const progressBar = document.getElementById('timelineSimProgress');
            if (progressBar) progressBar.style.width = `${(stepNum / 6) * 100}%`;

            const statusText = document.getElementById('simStatusText');
            if (statusText && timelineDescriptions[stepNum]) {
                statusText.innerText = timelineDescriptions[stepNum];
            }
        }

        let simTimer = null;
        function runEmergencyTimelineSimulation() {
            if (simTimer) clearInterval(simTimer);
            
            const btnText = document.getElementById('simPlayText');
            const btnIcon = document.getElementById('simPlayIcon');
            if (btnText) btnText.innerText = 'Simulating Workflow...';
            if (btnIcon) btnIcon.innerText = '🔄';

            let currentStep = 1;
            selectTimelineStep(currentStep);

            simTimer = setInterval(() => {
                currentStep++;
                if (currentStep > 6) {
                    clearInterval(simTimer);
                    if (btnText) btnText.innerText = 'Replay Live Simulation';
                    if (btnIcon) btnIcon.innerText = '▶';
                    return;
                }
                selectTimelineStep(currentStep);
            }, 1400);
        }
    </script>
</body>
</html>