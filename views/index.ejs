                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.3 8.9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.6 7.2C.6 9.2 0 11.5 0 14s.6 4.8 1.6 6.8l3.7-2.9z"/><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.3-6.7-5.3L1.6 16C3.5 19.8 7.4 23 12 23z"/></svg>
                    Google
                </button>
                <button type="button" class="btn-social">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00b4ff" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    ABHA / Health ID
                </button>
            </div>

            <div class="auth-footer">
                Don't have an account? <a href="/signup" id="toggleAuthMode">Sign up for free</a>
            </div>
        </div>
    </div>

    <!-- ================= GENERIC ACTION MODAL ================= -->
    <div class="auth-modal-backdrop" id="genericModal" aria-hidden="true" style="display:none; align-items:center; justify-content:center;">
        <div class="auth-modal-card" style="max-width:500px; text-align:center;">
            <h2 id="genericModalTitle" style="color:#fff; margin-bottom:12px;">Notice</h2>
            <p id="genericModalBody" style="color:#cbd5e1; font-size:1rem; margin-bottom:20px;"></p>
            <button class="btn-primary" style="padding:10px 24px; border-radius:8px;" onclick="closeGenericModal()">OK</button>
        </div>
    </div>

    <!-- ================= DOCTOR PROFILE MODAL ================= -->
    <div class="auth-modal-backdrop" id="doctorProfileModal" aria-hidden="true" style="display:none; align-items:center; justify-content:center;">
        <div class="auth-modal-card" style="max-width:500px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h2 id="profName" style="color:#fff;">Dr. Profile</h2>
                <button class="modal-close-btn" onclick="closeDoctorProfileModal()">✕</button>
            </div>
            <p id="profSpecialty" style="color:#38bdf8; font-weight:700;"></p>
            <p id="profExp" style="color:#94a3b8; font-size:0.9rem; margin-top:4px;"></p>
            <p id="profFee" style="color:#4ade80; font-weight:700; margin-top:8px;"></p>
            <p id="profLicense" style="color:#64748b; font-size:0.85rem; margin-top:4px;"></p>
            <button class="btn-primary" id="profBookBtn" style="width:100%; margin-top:20px; padding:12px; border-radius:8px; font-weight:700;">Book Appointment Now</button>
        </div>
    </div>

    <!-- ================= DOCTOR BOOKING MODAL ================= -->
    <div class="auth-modal-backdrop" id="bookingModal" aria-hidden="true" style="display:none; align-items:center; justify-content:center;">
        <div class="auth-modal-card" style="max-width:500px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h2 style="color:#fff;">Book Appointment</h2>
                <button class="modal-close-btn" onclick="closeBookingModal()">✕</button>
            </div>
            <p style="color:#94a3b8; margin-bottom:16px;">Doctor: <strong id="bookDocName" style="color:#fff;"></strong></p>
            <form onsubmit="event.preventDefault(); submitDoctorBooking();">
                <div class="form-group" style="margin-bottom:12px;">
                    <label style="color:#cbd5e1; font-size:0.85rem;">Select Date & Time</label>
                    <input type="datetime-local" id="bookDateTime" required style="width:100%; padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:rgba(15,23,42,0.9); color:#fff;">
                </div>
                <div class="form-group" style="margin-bottom:16px;">
                    <label style="color:#cbd5e1; font-size:0.85rem;">Reason for Consultation</label>
                    <input type="text" id="bookReason" placeholder="e.g. Routine Cardiac Checkup" required style="width:100%; padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:rgba(15,23,42,0.9); color:#fff;">
                </div>
                <button type="submit" class="btn-primary" style="width:100%; padding:12px; border-radius:8px; font-weight:700;">Confirm Appointment</button>
            </form>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script>
        // 1. Emergency SOS Workflow
        async function triggerSOSWorkflow() {
            if (!confirm("🚨 Emergency SOS Trigger\nDo you want to dispatch a cardiac ambulance and request immediate hospital bed reservation?")) return;

            try {
                const res = await fetch('/api/emergency/sos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        emergency_type: 'Acute Emergency SOS',
                        priority: 'critical',
                        location: 'Current GPS Location (Simulated)'
                    })
                });

                const data = await res.json();
                if (data.success && data.data && data.data.tracking_url) {
                    window.location.href = data.data.tracking_url;
                } else {
                    window.location.href = '/dashboard/patient';
                }
            } catch (err) {
                window.location.href = '/dashboard/patient';
            }
        }

        // 2. Generic Modal Helpers
        function showGenericModal(title, message) {
            document.getElementById('genericModalTitle').innerText = title;
            document.getElementById('genericModalBody').innerText = message;
            const modal = document.getElementById('genericModal');
            modal.style.display = 'flex';
        }
        function closeGenericModal() {
            document.getElementById('genericModal').style.display = 'none';
        }

        // 3. Hospital Search & Filter & Command Actions
        function filterHospitals() {
            const query = (document.getElementById('hospitalSearchInput')?.value || '').toLowerCase().trim();
            const cityFilter = (document.getElementById('hospitalCityFilter')?.value || '').toLowerCase().trim();
            const specialtyFilter = (document.getElementById('hospitalSpecialtyFilter')?.value || '').toLowerCase().trim();
            const emergencyOnly = document.getElementById('hospitalEmergencyToggle')?.checked || false;

            document.querySelectorAll('.hospital-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const city = (item.getAttribute('data-city') || '').toLowerCase();
                const specialty = (item.getAttribute('data-specialty') || '').toLowerCase();
                const isEmergency = item.getAttribute('data-emergency') === 'true';

                const matchesQuery = !query || name.includes(query) || city.includes(query) || specialty.includes(query);
                const matchesCity = !cityFilter || city.includes(cityFilter);
                const matchesSpecialty = !specialtyFilter || specialty.includes(specialtyFilter);
                const matchesEmergency = !emergencyOnly || isEmergency;

                const matches = matchesQuery && matchesCity && matchesSpecialty && matchesEmergency;
                item.style.display = matches ? '' : 'none';
            });
        }

        function useCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        showGenericModal(
                            '📍 Location Detected',
                            `GPS Coordinates: (${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}).\nNearby hospitals sorted by closest proximity.`
                        );
                    },
                    () => {
                        showGenericModal('📍 Proximity Filter Active', 'Nearby hospitals sorted by closest distance from your current location.');
                    }
                );
            } else {
                showGenericModal('📍 Proximity Filter Active', 'Nearby hospitals sorted by closest distance from your current location.');
            }
        }

        function getHospitalDirections(hospitalName) {
            showGenericModal(
                `🗺️ Route Navigation: ${hospitalName}`,
                `Live GPS traffic-aware route generated.\nEstimated Arrival Time: 6–10 minutes with emergency priority dispatch.`
            );
        }

        function callHospitalNumber(phone) {
            showGenericModal(
                `📞 Direct Hospital Emergency Line`,
                `Connecting call to Emergency Desk at ${phone}.\nLine Status: Connected.`
            );
        }

        function openHospitalModal(name, beds, icu, phone) {
            showGenericModal(
                '🏥 Emergency Bed Reserved',
                `Reserved bed at ${name}.\nAvailable: ${beds} | ICU: ${icu}\nEmergency Desk: ${phone}`
            );
        }

        // 4. Doctor Search & Filter
        function filterDoctors() {
            const query = (document.getElementById('doctorSearchInput').value || '').toLowerCase();
            const specialtyFilter = (document.getElementById('doctorSpecialtyFilter').value || '').toLowerCase();
            document.querySelectorAll('.doctor-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const spec = (item.getAttribute('data-specialty') || '').toLowerCase();
                const matches = name.includes(query) && (!specialtyFilter || spec.includes(specialtyFilter));
                item.style.display = matches ? 'block' : 'none';
            });
        }

        function openDoctorProfile(name, spec, exp, fee, license) {
            document.getElementById('profName').innerText = name;
            document.getElementById('profSpecialty').innerText = spec;
            document.getElementById('profExp').innerText = `Experience: ${exp} • License: ${license}`;
            document.getElementById('profFee').innerText = `Consultation Fee: ${fee}`;
            document.getElementById('profBookBtn').onclick = () => {
                closeDoctorProfileModal();
                openBookingModal(name, 'doc-01');
            };
            document.getElementById('doctorProfileModal').style.display = 'flex';
        }
        function closeDoctorProfileModal() {
            document.getElementById('doctorProfileModal').style.display = 'none';
        }

        // 5. Appointment Booking Modal & Submission
        let currentBookingDoctor = '';
        function openBookingModal(docName, docId) {
            currentBookingDoctor = docName;
            document.getElementById('bookDocName').innerText = docName;
            document.getElementById('bookingModal').style.display = 'flex';
        }
        function closeBookingModal() {
            document.getElementById('bookingModal').style.display = 'none';
        }

        async function submitDoctorBooking() {
            const dateVal = document.getElementById('bookDateTime').value;
            const reason = document.getElementById('bookReason').value;
            closeBookingModal();

            try {
                await fetch('/api/appointments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctor_name: currentBookingDoctor, appointment_date: dateVal, reason })
                });
            } catch(e) {}

            showGenericModal(
                '✓ Appointment Confirmed',
                `Your appointment with ${currentBookingDoctor} is confirmed for ${dateVal || 'Tomorrow, 10:00 AM'}.\nReason: ${reason || 'Consultation'}`
            );
        }

        // 6. Blood Bank Request
        function requestBloodUnit() {
            const group = prompt("Enter Blood Group needed (e.g. A+, O-, B+):", "O-");
            if (!group) return;
            showGenericModal(
                '🩸 Blood Request Dispatched',
                `Emergency request for ${group} blood units sent to Metro Blood Repository. Matching hospital units reserved.`
            );
        }

        // 7. Ambulance Dispatch Simulator
        function dispatchAmbulanceProgress(vehicle) {
            showGenericModal("🚨 Dispatching Ambulance...", `Searching nearest active unit for ${vehicle}...`);
            setTimeout(() => {
                showGenericModal(
                    "🚑 Ambulance Assigned!",
                    `Unit ${vehicle} assigned!\nDriver: John Miller (+1 555 0881)\nETA: 4 Minutes (En Route)`
                );
            }, 1200);
        }

        // 8. AI Assistant Chat Evaluation
        async function sendAIChat(symptomsText) {
            document.getElementById('aiChatInput').value = symptomsText;
            submitAIChatForm();
        }

        async function submitAIChatForm() {
            const input = document.getElementById('aiChatInput');
            const chatOutput = document.getElementById('aiChatOutput');
            const submitBtn = document.getElementById('aiSubmitBtn');
            const btnText = document.getElementById('aiBtnText');
            const btnSpinner = document.getElementById('aiBtnSpinner');

            const text = input.value.trim();
            if (!text) return;

            // Loading state: Spinner, Disable button, Show output container
            if (submitBtn) submitBtn.disabled = true;
            if (btnText) btnText.innerText = 'Analyzing...';
            if (btnSpinner) btnSpinner.style.display = 'inline-block';

            chatOutput.style.display = 'block';
            chatOutput.innerHTML = `
                <div style="background:rgba(0,0,0,0.4); padding:20px; border-radius:14px; text-align:center; border:1px solid rgba(14,165,233,0.3);">
                    <div style="font-size:2rem; margin-bottom:10px; animation:spin 1s linear infinite;">🧠</div>
                    <div style="color:#38bdf8; font-weight:700; font-size:1.05rem;">PulseX AI Clinical Triage in Progress...</div>
                    <div style="color:#94a3b8; font-size:0.85rem; margin-top:4px;">Evaluating symptom telemetry against evidence-based medical triage protocols...</div>
                    <div style="width:100%; height:4px; background:rgba(255,255,255,0.1); border-radius:2px; margin-top:14px; overflow:hidden;">
                        <div style="width:75%; height:100%; background:linear-gradient(90deg, #0ea5e9, #10b981); animation:pulseProgress 1.5s infinite;"></div>
                    </div>
                </div>
            `;

            try {
                const res = await fetch('/api/ai/triage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ symptoms: text })
                });

                const result = await res.json();
                const data = result.data || {};

                const urgency = (data.urgency || 'MEDIUM').toUpperCase();
                const isEmergency = urgency === 'EMERGENCY' || urgency === 'HIGH' || data.should_call_ambulance;

                let urgencyColor = '#22c55e'; // Green LOW
                let urgencyBg = 'rgba(34,197,94,0.15)';
                let urgencyIcon = '🌱';

                if (urgency === 'MEDIUM') {
                    urgencyColor = '#eab308';
                    urgencyBg = 'rgba(234,179,8,0.15)';
                    urgencyIcon = '⚡';
                } else if (urgency === 'HIGH') {
                    urgencyColor = '#f97316';
                    urgencyBg = 'rgba(249,115,22,0.15)';
                    urgencyIcon = '⚠️';
                } else if (urgency === 'EMERGENCY') {
                    urgencyColor = '#ef4444';
                    urgencyBg = 'rgba(239,68,68,0.2)';
                    urgencyIcon = '🚨';
                }

                const confidencePct = Math.round((data.confidence || 0.92) * 100);

                let html = `
                    <div style="display:flex; flex-direction:column; gap:16px;">
                        
                        <!-- URGENCY & CONFIDENCE HEADER CARD -->
                        <div style="background:${urgencyBg}; border:1px solid ${urgencyColor}; border-radius:14px; padding:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                            <div>
                                <span style="background:${urgencyColor}; color:#fff; font-weight:800; font-size:0.8rem; padding:4px 12px; border-radius:20px; text-transform:uppercase; letter-spacing:0.5px;">${urgencyIcon} ${urgency} URGENCY</span>
                                <h3 style="color:#fff; margin-top:8px; font-size:1.2rem;">${data.summary || 'Clinical Triage Evaluation'}</h3>
                            </div>
                            <div style="text-align:right;">
                                <div style="color:#94a3b8; font-size:0.75rem; font-weight:700;">AI CONFIDENCE SCORE</div>
                                <div style="color:${urgencyColor}; font-size:1.5rem; font-weight:800;">${confidencePct}%</div>
                            </div>
                        </div>

                        <!-- POSSIBLE CONDITIONS & SPECIALIST CARD -->
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">
                            
                            <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:18px;">
                                <div style="color:#38bdf8; font-weight:700; font-size:0.9rem; margin-bottom:8px;">🩺 Possible Clinical Conditions</div>
                                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                    ${(data.possible_conditions || []).map(c => `<span style="background:rgba(14,165,233,0.15); color:#38bdf8; border:1px solid rgba(14,165,233,0.3); padding:4px 10px; border-radius:12px; font-size:0.8rem;">${c}</span>`).join('')}
                                </div>
                            </div>

                            <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:18px;">
                                <div style="color:#4ade80; font-weight:700; font-size:0.9rem; margin-bottom:6px;">👨‍⚕️ Recommended Specialist & Department</div>
                                <div style="color:#fff; font-weight:700; font-size:0.95rem;">${data.recommended_specialist || 'General Medicine'}</div>
                                <div style="color:#94a3b8; font-size:0.85rem; margin-top:2px;">Department: ${data.recommended_department || 'Outpatient Clinic'}</div>
                            </div>

                        </div>

                        <!-- FIRST AID & RED FLAGS CARD -->
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">
                            
                            <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:18px;">
                                <div style="color:#4ade80; font-weight:700; font-size:0.9rem; margin-bottom:8px;">🩹 First-Aid Advice</div>
                                <ul style="margin:0; padding-left:18px; color:#cbd5e1; font-size:0.85rem;">
                                    ${(data.first_aid || []).map(fa => `<li style="margin-bottom:4px;">${fa}</li>`).join('')}
                                </ul>
                            </div>

                            <div style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.2); border-radius:14px; padding:18px;">
                                <div style="color:#f87171; font-weight:700; font-size:0.9rem; margin-bottom:8px;">⚠️ Red Flag Warning Symptoms</div>
                                <ul style="margin:0; padding-left:18px; color:#fca5a5; font-size:0.85rem;">
                                    ${(data.red_flags || []).map(rf => `<li style="margin-bottom:4px;">${rf}</li>`).join('')}
                                </ul>
                            </div>

                        </div>

                        <!-- RECOMMENDED TESTS CARD -->
                        <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:18px;">
                            <div style="color:#a855f7; font-weight:700; font-size:0.9rem; margin-bottom:8px;">🧪 Recommended Diagnostic Tests</div>
                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                ${(data.recommended_tests || []).map(t => `<span style="background:rgba(168,85,247,0.15); color:#c084fc; border:1px solid rgba(168,85,247,0.3); padding:4px 10px; border-radius:12px; font-size:0.8rem;">${t}</span>`).join('')}
                            </div>
                        </div>
                `;

                // EMERGENCY ACTIONS vs LOW/MEDIUM ACTIONS
                if (isEmergency) {
                    html += `
                        <!-- AUTOMATIC EMERGENCY ACTION PANEL -->
                        <div style="background:rgba(239,68,68,0.15); border:2px solid #ef4444; border-radius:14px; padding:20px; margin-top:8px;">
                            <div style="color:#f87171; font-weight:800; font-size:1.1rem; margin-bottom:4px;">🚨 IMMEDIATE EMERGENCY ACTION REQUIRED</div>
                            <div style="color:#cbd5e1; font-size:0.88rem; margin-bottom:16px;">Symptoms indicate a potential emergency. Please initiate emergency response protocols below immediately:</div>
                            
                            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:10px;">
                                <button class="btn-primary" style="background:#ef4444; color:#fff; border:none; padding:12px; border-radius:10px; font-weight:700; cursor:pointer;" onclick="triggerSOSWorkflow()">🚑 Trigger Emergency SOS</button>
                                <a href="#hospitals" class="btn-secondary" style="display:block; text-align:center; padding:12px; border-radius:10px; background:rgba(14,165,233,0.2); color:#38bdf8; border:1px solid rgba(14,165,233,0.4); text-decoration:none; font-weight:700;">🏥 Find Nearby Hospitals</a>
                                <a href="#doctors" class="btn-secondary" style="display:block; text-align:center; padding:12px; border-radius:10px; background:rgba(16,185,129,0.2); color:#4ade80; border:1px solid rgba(16,185,129,0.4); text-decoration:none; font-weight:700;">👨‍⚕️ Find Available Doctors</a>
                                <button class="btn-secondary" style="padding:12px; border-radius:10px; background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4); font-weight:700; cursor:pointer;" onclick="openBookingModal('${data.recommended_specialist || 'Emergency Doctor'}', 'doc-01')">📅 Book Appointment</button>
                                <button class="btn-secondary" style="padding:12px; border-radius:10px; background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); font-weight:700; cursor:pointer;" onclick="requestBloodUnit()">🩸 Blood Bank Repository</button>
                                <button class="btn-secondary" style="padding:12px; border-radius:10px; background:rgba(168,85,247,0.2); color:#c084fc; border:1px solid rgba(168,85,247,0.4); font-weight:700; cursor:pointer;" onclick="dispatchAmbulanceProgress('Cardiac ICU Unit')">🚑 Request Ambulance</button>
                            </div>

                            <div style="margin-top:14px; font-weight:700; font-size:0.85rem; color:#fca5a5;">
                                📞 Emergency Helpline Direct: 911 / 112 | PulseX Cardiac Emergency Line: +1 800 555 0199
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <!-- LOW / MEDIUM URGENCY ACTIONS -->
                        <div style="background:rgba(14,165,233,0.08); border:1px solid rgba(14,165,233,0.2); border-radius:14px; padding:18px; margin-top:8px;">
                            <div style="color:#38bdf8; font-weight:700; font-size:0.95rem; margin-bottom:8px;">👍 Self-Care Advice & OPD Consultation</div>
                            <div style="color:#cbd5e1; font-size:0.85rem; margin-bottom:12px;">Symptoms appear manageable with outpatient care. Schedule an OPD appointment with a recommended doctor:</div>
                            
                            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                <button class="btn-primary" style="padding:10px 20px; border-radius:10px; font-weight:700; cursor:pointer;" onclick="openBookingModal('${data.recommended_specialist || 'General Medicine Specialist'}', 'doc-01')">📅 Book Appointment</button>
                                <a href="#doctors" class="btn-secondary" style="padding:10px 20px; border-radius:10px; background:rgba(255,255,255,0.06); color:#fff; text-decoration:none; font-weight:600;">👨‍⚕️ View Recommended Doctors</a>
                            </div>

                            ${(data.follow_up_questions && data.follow_up_questions.length > 0) ? `
                                <div style="margin-top:14px; color:#94a3b8; font-size:0.82rem;">
                                    <strong>Follow-up Questions to consider:</strong> ${data.follow_up_questions.join(' • ')}
                                </div>
                            ` : ''}
                        </div>
                    `;
                }

                // DISCLAIMER CARD
                html += `
                        <div style="color:#64748b; font-size:0.75rem; text-align:center; margin-top:8px; border-top:1px solid rgba(255,255,255,0.06); padding-top:10px;">
                            🔒 ${data.disclaimer || 'This AI provides informational guidance only and is not a substitute for a licensed healthcare professional.'}
                        </div>

                    </div>
                `;

                chatOutput.innerHTML = html;

            } catch (err) {
                chatOutput.innerHTML = `
                    <div style="background:rgba(239,68,68,0.15); border:1px solid #ef4444; border-radius:14px; padding:18px; color:#f87171;">
                        <strong>⚠️ Triage Service Error:</strong> Failed to complete AI triage analysis. Please verify your connection or call emergency assistance directly if in distress.
                    </div>
                `;
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (btnText) btnText.innerText = 'Analyze Triage';
                if (btnSpinner) btnSpinner.style.display = 'none';
            }
        }

        // 9. Volunteer Network Connection
        function connectVolunteer(volName) {
            showGenericModal(
                '🤝 First Responder Alerted',
                `Alert notification sent to volunteer ${volName}. Proximity GPS tracking active.`
            );
        }

        // 10. Blood Bank Filter & Actions
        function filterBloodGroupCards() {
            const query = document.getElementById('bloodSearchInput').value.trim().toUpperCase();
            const cards = document.querySelectorAll('.blood-group-item');

            cards.forEach(card => {
                const group = card.getAttribute('data-group').toUpperCase();
                if (!query || group.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function setBloodPillFilter(selectedGroup, btnElement) {
            document.querySelectorAll('#bloodPillFilters .blood-filter-pill').forEach(pill => pill.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');

            const cards = document.querySelectorAll('.blood-group-item');
            cards.forEach(card => {
                const group = card.getAttribute('data-group');
                if (selectedGroup === 'ALL' || group === selectedGroup) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function requestBloodGroupUnit(group) {
            showGenericModal(
                `🩸 Request ${group} Blood Units`,
                `Emergency dispatch initiated for ${group} blood group across 18 connected repositories. Estimated reserve confirmation: 2 minutes.`
            );
        }

        function findNearbyBloodBanks() {
            showGenericModal(
                '🏥 Nearby Blood Bank Repositories',
                `1. Metro Central Blood Bank (1.2 km) - Open 24/7\n2. St. Jude Blood Repository (3.4 km) - Open 24/7\n3. Apex Trauma Blood Center (5.1 km) - Open 24/7`
            );
        }

        function openDonorModal() {
            showGenericModal(
                '🤝 PulseX Blood Donor Registration',
                `Thank you for offering to donate! Your voluntary blood donation saves lives.\n\nPlease confirm your blood type at your nearest PulseX partner hospital or book a donation slot in your profile settings.`
            );
        }
    </script>
</body>
</html>