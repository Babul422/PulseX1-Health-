<%- include('../partials/auth-header', { pageTitle: 'Patient Care Dashboard - PulseX Health', activeTab: 'dashboard' }) %>

<!-- LEFT SIDEBAR -->
<%- include('../partials/auth-sidebar') %>

<!-- RIGHT MAIN CONTENT (UNIFIED DASHBOARD WIDGETS STACK) -->
<div class="auth-main-content">

    <!-- WELCOME BANNER -->
    <div class="auth-card" style="background: linear-gradient(135deg, rgba(14,165,233,0.15), rgba(15,23,42,0.9)); border-color: rgba(14,165,233,0.3); display:flex; justify-content:space-between; align-items:center;">
        <div>
            <span class="role-tag tag-doctor" style="background:rgba(14,165,233,0.2); color:#38bdf8;">AUTHENTICATED CARE PORTAL</span>
            <h1 style="color:#fff; font-size:1.6rem; margin-top:8px;">Welcome back, <%= user.full_name || 'Alex Johnson' %> 👋</h1>
            <p style="color:#cbd5e1; margin-top:4px;">Patient ID: <strong>0847192</strong> • Blood Group: <strong style="color:#f87171;"><%= user.blood_group || 'O+' %></strong></p>
        </div>
        <button class="btn-primary" style="padding:12px 20px; border-radius:12px; font-weight:700; cursor:pointer;" onclick="triggerPatientSOS()">🚨 DISPATCH SOS</button>
    </div>

    <!-- QUICK STATS GRID -->
    <div class="auth-card">
        <div class="auth-card-title">
            <span>📊 Health Summary & Stats</span>
        </div>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-num"><%= appointments.length %></div>
                <div class="stat-lbl">UPCOMING OPDS</div>
            </div>
            <div class="stat-card" style="background:rgba(34,197,94,0.08); border-color:rgba(34,197,94,0.2);">
                <div class="stat-num" style="color:#4ade80;"><%= medicalRecords.length %></div>
                <div class="stat-lbl">EHR RECORDS</div>
            </div>
            <div class="stat-card" style="background:rgba(239,68,68,0.08); border-color:rgba(239,68,68,0.2);">
                <div class="stat-num" style="color:#f87171;">24/7</div>
                <div class="stat-lbl">ICU DISPATCH</div>
            </div>
            <div class="stat-card" style="background:rgba(168,85,247,0.08); border-color:rgba(168,85,247,0.2);">
                <div class="stat-num" style="color:#c084fc;">4 MIN</div>
                <div class="stat-lbl">AVG AMBULANCE ETA</div>
            </div>
        </div>
    </div>

    <!-- EMERGENCY SOS LAUNCHER CARD -->
    <div class="auth-card" style="background:linear-gradient(135deg, rgba(239,68,68,0.15), rgba(15,23,42,0.9)); border-color:rgba(239,68,68,0.3);" id="emergency-section">
        <div class="auth-card-title">
            <span style="color:#f87171;">🚨 Emergency SOS Launcher</span>
            <span class="role-tag tag-doctor" style="background:rgba(239,68,68,0.2); color:#f87171;">CRITICAL TRIAGE</span>
        </div>
        <p style="color:#cbd5e1; font-size:0.9rem; margin-bottom:16px;">Triggers AI clinical triage, reserves nearest ICU bed, and dispatches a cardiac ambulance with live GPS tracking.</p>
        <button class="btn-dash-sos" style="width:100%; padding:14px; border-radius:12px; font-weight:800; font-size:1.05rem;" onclick="triggerPatientSOS()">LAUNCH EMERGENCY SOS NOW</button>
    </div>

    <!-- UPCOMING APPOINTMENTS -->
    <div class="auth-card" id="appointments-section">
        <div class="auth-card-title">
            <span>📅 Upcoming Appointments</span>
        </div>
        <table class="data-table">
            <thead>
                <tr><th>Doctor</th><th>Date</th><th>Status</th></tr>
            </thead>
            <tbody>
                <% appointments.forEach(a => { %>
                    <tr>
                        <td><strong><%= a.doctor_name || 'Dr. Sarah Connor' %></strong></td>
                        <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
                        <td><span style="color:#4ade80; font-weight:700;"><%= a.status %></span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- REAL-TIME HOSPITAL BEDS TRACKER -->
    <div class="auth-card" id="hospitals-section">
        <div class="auth-card-title">
            <span>🏥 Real-Time Hospital Beds</span>
        </div>
        <table class="data-table">
            <thead>
                <tr><th>Hospital</th><th>Available Beds</th><th>ICU Beds</th></tr>
            </thead>
            <tbody>
                <% hospitals.slice(0,4).forEach(h => { %>
                    <tr>
                        <td><strong><%= h.name %></strong></td>
                        <td><span style="color:#4ade80; font-weight:700;"><%= h.available_beds %></span> / <%= h.total_beds %></td>
                        <td><span style="color:#38bdf8; font-weight:700;"><%= h.available_icu_beds %></span> / <%= h.icu_beds %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- MEDICAL RECORDS -->
    <div class="auth-card">
        <div class="auth-card-title">
            <span>📑 Medical Records (EHR)</span>
        </div>
        <table class="data-table">
            <thead>
                <tr><th>Title</th><th>Doctor</th><th>Date</th></tr>
            </thead>
            <tbody>
                <% medicalRecords.forEach(r => { %>
                    <tr>
                        <td><strong><%= r.title %></strong></td>
                        <td><%= r.doctor_name || 'Dr. Sarah Connor' %></td>
                        <td><%= r.record_date %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- SYSTEM NOTIFICATIONS -->
    <div class="auth-card" id="notifications-section">
        <div class="auth-card-title">
            <span>🔔 System & Care Notifications</span>
        </div>
        <div style="display:flex; flex-direction:column; gap:10px;">
            <div style="background:rgba(14,165,233,0.1); border-left:3px solid #0ea5e9; padding:12px 16px; border-radius:8px; font-size:0.88rem; color:#cbd5e1;">
                <strong style="color:#fff;">OPD Appointment Confirmed</strong><br>
                Your appointment with Dr. Sarah Connor is confirmed.
            </div>
            <div style="background:rgba(34,197,94,0.1); border-left:3px solid #22c55e; padding:12px 16px; border-radius:8px; font-size:0.88rem; color:#cbd5e1;">
                <strong style="color:#fff;">EHR Lab Report Uploaded</strong><br>
                ECG & Cardiac Evaluation Report added to medical records.
            </div>
        </div>
    </div>

</div>

<script>
    async function triggerPatientSOS() {
        if (!confirm("Confirm dispatch of emergency ambulance & hospital triage?")) return;
        try {
            const res = await fetch('/api/emergency/sos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ emergency_type: 'Acute Cardiac Distress SOS', priority: 'critical' })
            });
            const data = await res.json();
            if (data.success && data.data && data.data.tracking_url) {
                window.location.href = data.data.tracking_url;
            } else {
                window.location.href = '/dashboard/patient';
            }
        } catch (err) {
            window.location.href = '/dashboard/patient';
        }
    }
</script>

<%- include('../partials/auth-footer') %>
