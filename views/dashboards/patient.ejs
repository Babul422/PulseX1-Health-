<%- include('../partials/auth-header', { pageTitle: 'Patient Care Dashboard - PulseX Health', activeTab: 'dashboard' }) %>

<!-- LEFT SIDEBAR -->
<%- include('../partials/auth-sidebar') %>

<!-- RIGHT MAIN CONTENT (UNIFIED DASHBOARD WIDGETS STACK) -->
<div class="auth-main-content">

    <!-- 1. WELCOME BANNER WITH METRICS -->
    <div class="auth-card" style="background: linear-gradient(135deg, rgba(14,165,233,0.15) 0%, rgba(15,23,42,0.9) 100%); border-color: rgba(14,165,233,0.3); position:relative; overflow:hidden;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
            <div>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span class="role-tag tag-doctor" style="background:rgba(14,165,233,0.2); color:#38bdf8; font-weight:800;">PATIENT CARE PORTAL</span>
                    <span style="font-size:0.78rem; color:#4ade80; background:rgba(34,197,94,0.12); padding:3px 10px; border-radius:12px; border:1px solid rgba(34,197,94,0.3); font-weight:700;">● Normal Vitals Sync</span>
                </div>
                <h1 style="color:#fff; font-size:1.65rem; font-weight:800; margin-top:10px; line-height:1.2;">Welcome back, <%= user.full_name || "Alex Johnson" %> 👋</h1>
                <p style="color:#cbd5e1; font-size:0.88rem; margin-top:4px;">Patient ID: <strong style="color:#fff;">0847192</strong> • Blood Group: <strong style="color:#f87171;"><%= user.blood_group || "O+" %></strong></p>
            </div>
            
            <!-- Quick Metadata Pill Container -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:12px 16px; display:flex; flex-direction:column; gap:6px; min-width:210px;">
                <div style="font-size:0.78rem; color:#94a3b8; display:flex; justify-content:space-between;">
                    <span>Last Login:</span> <strong style="color:#fff;">Today, 10:45 AM</strong>
                </div>
                <div style="font-size:0.78rem; color:#94a3b8; display:flex; justify-content:space-between;">
                    <span>Health Status:</span> <strong style="color:#4ade80;">● Normal Vitals</strong>
                </div>
                <div style="font-size:0.78rem; color:#94a3b8; display:flex; justify-content:space-between;">
                    <span>Next Appt:</span> <strong style="color:#38bdf8;"><%= (appointments && appointments.length > 0) ? (appointments[0].doctor_name || "Dr. Sarah Connor") : "None Scheduled" %></strong>
                </div>
                <div style="font-size:0.78rem; color:#94a3b8; display:flex; justify-content:space-between;">
                    <span>Notifications:</span> <strong style="color:#c084fc;">2 Care Alerts</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. FOUR RESPONSIVE STATISTIC CARDS -->
    <div class="stats-grid">
        <div class="stat-card" style="background:rgba(14,165,233,0.08); border-color:rgba(14,165,233,0.25);">
            <div class="stat-num" style="color:#38bdf8;"><%= appointments.length %></div>
            <div class="stat-lbl" style="color:#94a3b8; font-weight:700;">UPCOMING OPDS</div>
            <div style="font-size:0.72rem; color:#38bdf8; margin-top:4px; font-weight:600;">Scheduled Consultations</div>
        </div>

        <div class="stat-card" style="background:rgba(34,197,94,0.08); border-color:rgba(34,197,94,0.25);">
            <div class="stat-num" style="color:#4ade80;"><%= medicalRecords.length %></div>
            <div class="stat-lbl" style="color:#94a3b8; font-weight:700;">MEDICAL RECORDS</div>
            <div style="font-size:0.72rem; color:#4ade80; margin-top:4px; font-weight:600;">EHR Documents Active</div>
        </div>

        <div class="stat-card" style="background:rgba(239,68,68,0.08); border-color:rgba(239,68,68,0.25);">
            <div class="stat-num" style="color:#f87171;">READY</div>
            <div class="stat-lbl" style="color:#94a3b8; font-weight:700;">EMERGENCY DISPATCH</div>
            <div style="font-size:0.72rem; color:#f87171; margin-top:4px; font-weight:600;">24/7 ICU Proximity Mesh</div>
        </div>

        <div class="stat-card" style="background:rgba(168,85,247,0.08); border-color:rgba(168,85,247,0.25);">
            <div class="stat-num" style="color:#c084fc;">3.8 M</div>
            <div class="stat-lbl" style="color:#94a3b8; font-weight:700;">AVG AMBULANCE ETA</div>
            <div style="font-size:0.72rem; color:#c084fc; margin-top:4px; font-weight:600;">Real-Time GPS Tracking</div>
        </div>
    </div>

    <!-- 3. PREMIUM EMERGENCY SOS LAUNCHER CARD -->
    <div class="auth-card" style="background:linear-gradient(135deg, rgba(239,68,68,0.18) 0%, rgba(15,23,42,0.92) 100%); border-color:rgba(239,68,68,0.35);" id="emergency-section">
        <div class="auth-card-title">
            <span style="color:#f87171; display:flex; align-items:center; gap:8px;">
                <span>🚨</span> Emergency Dispatch Command Center
            </span>
            <span class="role-tag tag-doctor" style="background:rgba(239,68,68,0.25); color:#f87171; font-weight:800;">CRITICAL TRIAGE</span>
        </div>
        <p style="color:#cbd5e1; font-size:0.88rem; margin-bottom:18px; line-height:1.5;">
            Triggers immediate AI clinical triage, reserves the nearest specialized hospital ICU bed, and dispatches a cardiac ambulance with live satellite telemetry.
        </p>
        <button class="btn-dash-sos sos-premium-btn sos-pulse-ring" style="width:100%; padding:16px; border-radius:14px; font-weight:800; font-size:1.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px;" onclick="triggerPatientSOS()">
            <span>🚑</span>
            <span>LAUNCH EMERGENCY SOS DISPATCH NOW</span>
        </button>
    </div>

    <!-- 4. QUICK ACTIONS SECTION -->
    <div class="auth-card">
        <div class="auth-card-title">
            <span>⚡ Quick Health Actions</span>
        </div>
        <div class="quick-action-grid">
            
            <div class="quick-action-card" onclick="openPatientBookingModal()">
                <div class="quick-action-icon" style="background:rgba(56,189,248,0.15); color:#38bdf8;">📅</div>
                <div>
                    <div style="color:#fff; font-weight:800; font-size:0.95rem;">Book Appointment</div>
                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">Consult top specialists</div>
                </div>
            </div>

            <div class="quick-action-card" onclick="triggerPatientAITriage()">
                <div class="quick-action-icon" style="background:rgba(168,85,247,0.15); color:#c084fc;">🤖</div>
                <div>
                    <div style="color:#fff; font-weight:800; font-size:0.95rem;">AI Clinical Triage</div>
                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">Symptom evaluation</div>
                </div>
            </div>

            <div class="quick-action-card" onclick="document.getElementById('records-section').scrollIntoView({behavior:'smooth'})">
                <div class="quick-action-icon" style="background:rgba(34,197,94,0.15); color:#4ade80;">📑</div>
                <div>
                    <div style="color:#fff; font-weight:800; font-size:0.95rem;">Medical Records</div>
                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">View EHR lab reports</div>
                </div>
            </div>

            <div class="quick-action-card" onclick="requestPatientBlood()">
                <div class="quick-action-icon" style="background:rgba(239,68,68,0.15); color:#f87171;">🩸</div>
                <div>
                    <div style="color:#fff; font-weight:800; font-size:0.95rem;">Blood Requests</div>
                    <div style="color:var(--color-text-gray); font-size:0.78rem; margin-top:2px;">Emergency blood units</div>
                </div>
            </div>

        </div>
    </div>

    <!-- 5. UPCOMING APPOINTMENT CARD WITH QUICK ACTIONS -->
    <div class="auth-card" id="appointments-section">
        <div class="auth-card-title">
            <span>📅 Upcoming Consultations & OPDs</span>
            <button class="btn-primary" style="padding:6px 14px; border-radius:8px; font-size:0.78rem; font-weight:700; cursor:pointer;" onclick="openPatientBookingModal()">+ Book New OPD</button>
        </div>

        <% if (appointments && appointments.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:14px;">
                <% appointments.forEach(a => { %>
                    <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:16px; padding:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
                        <div style="display:flex; align-items:center; gap:14px;">
                            <div style="width:46px; height:46px; border-radius:12px; background:rgba(56,189,248,0.12); border:1px solid rgba(56,189,248,0.3); color:#38bdf8; display:flex; align-items:center; justify-content:center; font-size:1.2rem; font-weight:800;">🩺</div>
                            <div>
                                <h4 style="color:#fff; font-size:1.05rem; font-weight:800; margin:0;"><%= a.doctor_name || "Dr. Sarah Connor" %></h4>
                                <div style="color:var(--color-text-gray); font-size:0.82rem; margin-top:3px;">Cardiology & Critical Care • City Care General Hospital</div>
                                <div style="display:flex; gap:8px; margin-top:6px;">
                                    <span style="background:rgba(56,189,248,0.12); color:#38bdf8; border:1px solid rgba(56,189,248,0.25); font-size:0.74rem; font-weight:700; padding:2px 8px; border-radius:6px;">📅 <%= new Date(a.appointment_date).toLocaleDateString() %></span>
                                    <span style="background:rgba(34,197,94,0.12); color:#4ade80; border:1px solid rgba(34,197,94,0.25); font-size:0.74rem; font-weight:700; padding:2px 8px; border-radius:6px;">● <%= a.status %></span>
                                </div>
                            </div>
                        </div>

                        <div style="display:flex; gap:8px;">
                            <button style="padding:8px 14px; border-radius:8px; background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.3); color:#38bdf8; font-size:0.78rem; font-weight:700; cursor:pointer;" onclick="viewApptDetails('<%= a.doctor_name || "Dr. Sarah Connor" %>', '<%= new Date(a.appointment_date).toLocaleDateString() %>', '<%= a.status %>')">View Details</button>
                            <button style="padding:8px 14px; border-radius:8px; background:rgba(234,179,8,0.1); border:1px solid rgba(234,179,8,0.3); color:#facc15; font-size:0.78rem; font-weight:700; cursor:pointer;" onclick="rescheduleAppointment('<%= a.id %>')">Reschedule</button>
                            <button style="padding:8px 14px; border-radius:8px; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); color:#f87171; font-size:0.78rem; font-weight:700; cursor:pointer;" onclick="cancelAppointment('<%= a.id %>')">Cancel</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div style="text-align:center; padding:24px; color:var(--color-text-gray); font-size:0.9rem;">
                No upcoming appointments scheduled. Click "+ Book New OPD" to consult a specialist.
            </div>
        <% } %>
    </div>

    <!-- 6. RECENT ACTIVITY CARD -->
    <div class="auth-card">
        <div class="auth-card-title">
            <span>📡 Recent Patient Activity & Care Log</span>
            <span style="font-size:0.75rem; color:#4ade80; background:rgba(34,197,94,0.12); padding:3px 10px; border-radius:12px; border:1px solid rgba(34,197,94,0.3);">Live Log Sync</span>
        </div>

        <div style="display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; align-items:center; gap:12px; padding:12px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.04); border-radius:10px; font-size:0.85rem;">
                <div style="width:32px; height:32px; border-radius:8px; background:rgba(34,197,94,0.15); color:#4ade80; display:flex; align-items:center; justify-content:center; font-size:0.9rem;">✅</div>
                <div style="flex:1;">
                    <strong style="color:#fff;">OPD Consultation Confirmed</strong> with Dr. Sarah Connor.
                </div>
                <span style="color:var(--color-text-gray); font-size:0.75rem;">10 mins ago</span>
            </div>

            <div style="display:flex; align-items:center; gap:12px; padding:12px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.04); border-radius:10px; font-size:0.85rem;">
                <div style="width:32px; height:32px; border-radius:8px; background:rgba(56,189,248,0.15); color:#38bdf8; display:flex; align-items:center; justify-content:center; font-size:0.9rem;">📑</div>
                <div style="flex:1;">
                    <strong style="color:#fff;">EHR Lab Report Uploaded</strong> (ECG & Cardiac Evaluation Report).
                </div>
                <span style="color:var(--color-text-gray); font-size:0.75rem;">2 hours ago</span>
            </div>

            <div style="display:flex; align-items:center; gap:12px; padding:12px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.04); border-radius:10px; font-size:0.85rem;">
                <div style="width:32px; height:32px; border-radius:8px; background:rgba(239,68,68,0.15); color:#f87171; display:flex; align-items:center; justify-content:center; font-size:0.9rem;">🚨</div>
                <div style="flex:1;">
                    <strong style="color:#fff;">Emergency ICU Dispatch Ready</strong> — Proximity mesh lock 99.9%.
                </div>
                <span style="color:var(--color-text-gray); font-size:0.75rem;">Yesterday</span>
            </div>
        </div>
    </div>

    <!-- 7. REAL-TIME HOSPITAL BEDS TRACKER -->
    <div class="auth-card" id="hospitals-section">
        <div class="auth-card-title">
            <span>🏥 Real-Time Hospital Bed Occupancy</span>
        </div>
        <table class="data-table">
            <thead>
                <tr><th>Hospital Name</th><th>Available Beds</th><th>ICU Capacity</th><th>Action</th></tr>
            </thead>
            <tbody>
                <% hospitals.slice(0,4).forEach(h => { %>
                    <tr>
                        <td><strong><%= h.name %></strong></td>
                        <td><span style="color:#4ade80; font-weight:700;"><%= h.available_beds %></span> / <%= h.total_beds %></td>
                        <td><span style="color:#38bdf8; font-weight:700;"><%= h.available_icu_beds %></span> / <%= h.icu_beds %></td>
                        <td><button style="padding:6px 12px; border-radius:6px; background:rgba(14,165,233,0.15); color:#38bdf8; border:1px solid rgba(14,165,233,0.3); font-size:0.75rem; font-weight:700; cursor:pointer;" onclick="reserveHospitalBed('<%= h.name %>', '<%= h.available_icu_beds %>')">Reserve</button></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- 8. MEDICAL RECORDS (EHR) -->
    <div class="auth-card" id="records-section">
        <div class="auth-card-title">
            <span>📑 Electronic Health Records (EHR)</span>
        </div>
        <table class="data-table">
            <thead>
                <tr><th>Title</th><th>Attending Physician</th><th>Date Uploaded</th><th>Document</th></tr>
            </thead>
            <tbody>
                <% medicalRecords.forEach(r => { %>
                    <tr>
                        <td><strong><%= r.title %></strong></td>
                        <td><%= r.doctor_name || "Dr. Sarah Connor" %></td>
                        <td><%= r.record_date %></td>
                        <td><button style="padding:6px 12px; border-radius:6px; background:rgba(34,197,94,0.15); color:#4ade80; border:1px solid rgba(34,197,94,0.3); font-size:0.75rem; font-weight:700; cursor:pointer;" onclick="viewEHRDoc('<%= r.title %>', '<%= r.doctor_name || "Dr. Sarah Connor" %>', '<%= r.record_date %>')">View EHR</button></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

<script>
    async function triggerPatientSOS() {
        if (!confirm("🚨 Confirm dispatch of emergency cardiac ambulance & hospital ICU triage?")) return;
        try {
            const res = await fetch('/api/emergency/sos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ emergency_type: 'Acute Cardiac Distress SOS', priority: 'critical' })
            });
            const data = await res.json();
            if (data.success && data.data && data.data.tracking_url) {
                window.location.href = data.data.tracking_url;
            } else {
                showGenericModal(
                    '🚨 Emergency Dispatch Activated',
                    'SOS signal transmitted to nearest cardiac unit. Ambulance dispatched (ETA: 3.8 Mins).'
                );
            }
        } catch (err) {
            showGenericModal(
                '🚨 Emergency Dispatch Activated',
                'SOS signal transmitted to nearest cardiac unit. Ambulance dispatched (ETA: 3.8 Mins).'
            );
        }
    }

    function openPatientBookingModal() {
        if (typeof openBookingModal === 'function') {
            openBookingModal('Dr. Sarah Connor', 'doc-101');
        } else {
            showGenericModal('📅 OPD Consultation Booking', 'Select specialist: Dr. Sarah Connor\nDate: Tomorrow, 10:00 AM\nHospital: City Care General Hospital');
        }
    }

    function triggerPatientAITriage() {
        window.location.href = '/#ai-assistant';
    }

    function requestPatientBlood() {
        showGenericModal(
            '🩸 Emergency Blood Bank Request',
            'Request for blood units broadcasted across 18 connected blood repository centers.\n\nMatching reserves: O+, A+, B+ ready for dispatch.'
        );
    }

    function viewApptDetails(doctor, date, status) {
        showGenericModal(
            '📅 Appointment Details',
            `Doctor: ${doctor}\nDate: ${date}\nStatus: ${status}\nHospital: City Care General Hospital\nRoom: OPD-304`
        );
    }

    function rescheduleAppointment(id) {
        showGenericModal(
            '📅 Reschedule Consultation',
            'Select new preferred date & time slot for your OPD consultation with Dr. Sarah Connor.'
        );
    }

    function cancelAppointment(id) {
        if (confirm("Are you sure you want to cancel this OPD appointment?")) {
            showGenericModal('📅 Appointment Cancelled', 'Your appointment has been cancelled successfully.');
        }
    }

    function reserveHospitalBed(hName, icuBeds) {
        showGenericModal(
            `🏥 Reserve Bed — ${hName}`,
            `ICU Beds Available Ready: ${icuBeds}\nLocation: Central Medical Zone\nStatus: Pre-intake brief transmitted.`
        );
    }

    function viewEHRDoc(title, doctor, date) {
        showGenericModal(
            `📑 ${title}`,
            `Document Type: EHR Clinical Evaluation\nDoctor: ${doctor}\nDate: ${date}\nStatus: Encrypted & Verified`
        );
    }
</script>

<%- include('../partials/auth-footer') %>
